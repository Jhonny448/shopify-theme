-content: center;\n\n    padding: 18px;\n\n    background: rgba(15, 13, 12, .62);\n\n    opacity: 0;\n    visibility: hidden;\n    pointer-events: none;\n\n    transition:\n      opacity .2s ease,\n      visibility .2s ease;\n  }\n\n  #{{ bb_root_id }} .bb-modal.is-open {\n    opacity: 1;\n    visibility: visible;\n    pointer-events: auto;\n  }\n\n\n  /* POPUP */\n\n  #{{ bb_root_id }} .bb-modal-panel {\n    direction: rtl;\n\n    width: min(520px, 94vw);\n    max-height: 84vh;\n\n    display: flex;\n    flex-direction: column;\n\n    overflow: hidden;\n\n    background: #ffffff;\n\n    border-radius: 16px;\n\n    box-shadow:\n      0 25px 70px rgba(0,0,0,.22);\n\n    transform:\n      scale(.97)\n      translateY(6px);\n\n    transition:\n      transform .2s ease;\n  }\n\n  #{{ bb_root_id }} .bb-modal.is-open .bb-modal-panel {\n    transform:\n      scale(1)\n      translateY(0);\n  }\n\n\n  /* =========================================================\n     MODAL HEADER\n  ========================================================= */\n\n  #{{ bb_root_id }} .bb-modal-header {\n    flex: 0 0 auto;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    gap: 12px;\n\n    padding: 16px 18px;\n\n    border-bottom: 1px solid #eee8e2;\n  }\n\n  #{{ bb_root_id }} .bb-modal-title {\n    margin: 0;\n\n    font-size: 17px;\n    line-height: 1.3;\n    font-weight: 700;\n\n    color: #181512;\n  }\n\n  #{{ bb_root_id }} .bb-modal-close {\n    flex: 0 0 auto;\n\n    width: 30px;\n    height: 30px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    padding: 0;\n\n    background: transparent;\n    border: 0;\n\n    color: #211d1a;\n\n    font-size: 24px;\n    line-height: 1;\n\n    cursor: pointer;\n  }\n\n\n  /* =========================================================\n     SEARCH\n  ========================================================= */\n\n  #{{ bb_root_id }} .bb-search-wrap {\n    flex: 0 0 auto;\n\n    padding: 11px 15px;\n\n    border-bottom: 1px solid #f0ece8;\n  }\n\n  #{{ bb_root_id }} .bb-search {\n    direction: rtl;\n\n    width: 100%;\n\n    padding: 10px 12px;\n\n    background: #fff;\n\n    border: 1px solid #ddd5ce;\n    border-radius: 8px;\n\n    outline: none;\n\n    font-family: inherit;\n    font-size: 13px;\n\n    color: #191512;\n  }\n\n  #{{ bb_root_id }} .bb-search:focus {\n    border-color: #9e9187;\n  }\n\n\n  /* =========================================================\n     VARIANT GRID\n  ========================================================= */\n\n  #{{ bb_root_id }} .bb-variants-scroll {\n    flex: 1 1 auto;\n\n    overflow-y: auto;\n    overscroll-behavior: contain;\n\n    padding: 12px;\n  }\n\n  #{{ bb_root_id }} .bb-variants {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n\n    gap: 10px;\n  }\n\n\n  /* VARIANT CARD */\n\n  #{{ bb_root_id }} .bb-variant {\n    position: relative;\n\n    width: 100%;\n    padding: 0;\n\n    overflow: hidden;\n\n    background: #ffffff;\n\n    border: 1px solid #e3ddd7;\n    border-radius: 10px;\n\n    text-align: right;\n\n    cursor: pointer;\n\n    transition:\n      border-color .18s ease,\n      box-shadow .18s ease,\n      transform .18s ease;\n\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  #{{ bb_root_id }} .bb-variant:hover:not(:disabled) {\n    border-color: #ada198;\n\n    box-shadow:\n      0 5px 16px rgba(0,0,0,.055);\n  }\n\n  #{{ bb_root_id }} .bb-variant:active:not(:disabled) {\n    transform: scale(.985);\n  }\n\n  #{{ bb_root_id }} .bb-variant.is-selected {\n    border:\n      2px solid #211d19;\n  }\n\n  #{{ bb_root_id }} .bb-variant:disabled {\n    cursor: not-allowed;\n    opacity: .42;\n  }\n\n\n  /* IMAGE */\n\n  #{{ bb_root_id }} .bb-variant-image-wrap {\n    position: relative;\n\n    width: 100%;\n    aspect-ratio: 1 / 1;\n\n    overflow: hidden;\n\n    background: #f5f3f1;\n  }\n\n  #{{ bb_root_id }} .bb-variant-image {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    object-position: center;\n  }\n\n\n  /* SOLD OUT */\n\n  #{{ bb_root_id }} .bb-sold-out {\n    position: absolute;\n\n    top: 7px;\n    right: 7px;\n\n    padding: 5px 7px;\n\n    background: rgba(255,255,255,.94);\n\n    border-radius: 5px;\n\n    font-size: 9px;\n    line-height: 1;\n\n    font-weight: 700;\n\n    color: #6c645d;\n  }\n\n\n  /* INFO */\n\n  #{{ bb_root_id }} .bb-variant-info {\n    padding: 9px;\n  }\n\n  #{{ bb_root_id }} .bb-variant-name {\n    display: block;\n\n    margin-bottom: 7px;\n\n    font-size: 11.5px;\n    line-height: 1.35;\n    font-weight: 650;\n\n    color: #201c19;\n  }\n\n  #{{ bb_root_id }} .bb-add-label {\n    display: inline-flex;\n\n    padding: 6px 8px;\n\n    background: #f4ece4;\n\n    border-radius: 6px;\n\n    font-size: 10px;\n    line-height: 1;\n\n    font-weight: 700;\n\n    color: #201c19;\n  }\n\n\n  /* =========================================================\n     NO SEARCH RESULTS\n  ========================================================= */\n\n  #{{ bb_root_id }} .bb-empty {\n    display: none;\n\n    padding: 35px 10px;\n\n    text-align: center;\n\n    font-size: 13px;\n\n    color: #706861;\n  }\n\n\n  /* =========================================================\n     MOBILE\n  ========================================================= */\n\n  @media screen and (max-width: 749px) {\n\n    #{{ bb_root_id }} {\n      margin-top: 7px;\n      margin-bottom: 12px;\n    }\n\n    #{{ bb_root_id }} .bb-card {\n      padding: 14px;\n\n      border-radius: 10px;\n    }\n\n    #{{ bb_root_id }} .bb-heading {\n      margin-bottom: 13px;\n    }\n\n    #{{ bb_root_id }} .bb-title {\n      font-size: 16px;\n    }\n\n    #{{ bb_root_id }} .bb-subtitle {\n      font-size: 12px;\n    }\n\n    #{{ bb_root_id }} .bb-slots,\n    #{{ bb_root_id }} .bb-slot-labels {\n      gap: 6px;\n    }\n\n    #{{ bb_root_id }} .bb-slot {\n      border-radius: 8px;\n    }\n\n    #{{ bb_root_id }} .bb-slot-plus {\n      width: 17px;\n      height: 17px;\n    }\n\n    #{{ bb_root_id }} .bb-slot-plus::before,\n    #{{ bb_root_id }} .bb-slot-plus::after {\n      width: 15px;\n      height: 1.3px;\n    }\n\n    #{{ bb_root_id }} .bb-slot-overlay {\n      right: 3px;\n      bottom: 3px;\n      left: 3px;\n\n      padding: 4px 2px;\n\n      font-size: 7.5px;\n    }\n\n    #{{ bb_root_id }} .bb-slot-label {\n      font-size: 8.5px;\n    }\n\n    #{{ bb_root_id }} .bb-progress {\n      margin-top: 12px;\n\n      font-size: 11.5px;\n    }\n\n\n    /* POPUP CENTERED ON MOBILE */\n\n    #{{ bb_root_id }} .bb-modal {\n      align-items: center;\n      justify-content: center;\n\n      padding: 14px;\n    }\n\n    #{{ bb_root_id }} .bb-modal-panel {\n      width: min(430px, 94vw);\n      max-height: 82vh;\n\n      border-radius: 15px;\n    }\n\n    #{{ bb_root_id }} .bb-modal-header {\n      padding: 14px 15px;\n    }\n\n    #{{ bb_root_id }} .bb-modal-title {\n      font-size: 16px;\n    }\n\n    #{{ bb_root_id }} .bb-search-wrap {\n      padding: 9px 12px;\n    }\n\n    #{{ bb_root_id }} .bb-variants-scroll {\n      padding: 9px;\n    }\n\n    #{{ bb_root_id }} .bb-variants {\n      grid-template-columns:\n        repeat(2, minmax(0, 1fr));\n\n      gap: 8px;\n    }\n\n    #{{ bb_root_id }} .bb-variant-info {\n      padding: 7px;\n    }\n\n    #{{ bb_root_id }} .bb-variant-name {\n      font-size: 10.5px;\n    }\n\n  }\n\n</style>\n\n\n<div\n  id=\"{{ bb_root_id }}\"\n  class=\"bb-root\"\n  data-slot-count=\"{{ bb_slot_count }}\"\n  data-allow-duplicates=\"{{ bb_allow_duplicates }}\"\n  data-design-mode=\"{{ request.design_mode }}\"\n>\n\n  {% if bb_product != blank %}\n\n    <div class=\"bb-card\">\n\n\n      <!-- ================================\n           HEADER\n      ================================= -->\n\n      <div class=\"bb-heading\">\n\n        <h3 class=\"bb-title\">\n          בחרי את הצבעים שלך\n        </h3>\n\n        <p class=\"bb-subtitle\">\n          בחרי 4 צבעים וצרי את הסט שלך\n        </p>\n\n      </div>\n\n\n      <!-- ================================\n           4 SLOTS\n      ================================= -->\n\n      <div class=\"bb-slots\">\n\n        {% for index in (1..bb_slot_count) %}\n\n          <button\n            type=\"button\"\n            class=\"bb-slot\"\n            data-slot-index=\"{{ forloop.index0 }}\"\n            aria-label=\"בחירת צבע {{ index }}\"\n          >\n\n            <span\n              class=\"bb-slot-plus\"\n              aria-hidden=\"true\"\n            ></span>\n\n            <img\n              class=\"bb-slot-image\"\n              alt=\"\"\n            >\n\n            <span class=\"bb-slot-overlay\"></span>\n\n          </button>\n\n        {% endfor %}\n\n      </div>\n\n\n      <!-- LABELS -->\n\n      <div class=\"bb-slot-labels\">\n\n        {% for index in (1..bb_slot_count) %}\n\n          <div class=\"bb-slot-label\">\n            צבע {{ index }}\n          </div>\n\n        {% endfor %}\n\n      </div>\n\n\n      <!-- PROGRESS -->\n\n      <div class=\"bb-progress\">\n\n        בחרת\n\n        <strong class=\"bb-selected-count\">\n          0\n        </strong>\n\n        מתוך\n\n        <strong>\n          {{ bb_slot_count }}\n        </strong>\n\n        צבעים\n\n      </div>\n\n\n      <!-- ERRORS -->\n\n      <div\n        class=\"bb-error\"\n        role=\"alert\"\n      ></div>\n\n\n      {% if request.design_mode %}\n\n        <div class=\"bb-dev-message\"></div>\n\n      {% endif %}\n\n\n    </div>\n\n\n    <!-- =====================================================\n         POPUP\n    ====================================================== -->\n\n    <div\n      class=\"bb-modal\"\n      aria-hidden=\"true\"\n    >\n\n      <div\n        class=\"bb-modal-panel\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-label=\"בחירת צבע\"\n      >\n\n\n        <!-- HEADER -->\n\n        <div class=\"bb-modal-header\">\n\n          <h3 class=\"bb-modal-title\">\n            בחרי את הצבע שלך\n          </h3>\n\n          <button\n            type=\"button\"\n            class=\"bb-modal-close\"\n            aria-label=\"סגירה\"\n          >\n            ×\n          </button>\n\n        </div>\n\n\n        <!-- SEARCH -->\n\n        <div class=\"bb-search-wrap\">\n\n          <input\n            type=\"search\"\n            class=\"bb-search\"\n            placeholder=\"חפשי צבע...\"\n            autocomplete=\"off\"\n          >\n\n        </div>\n\n\n        <!-- VARIANTS -->\n\n        <div class=\"bb-variants-scroll\">\n\n          <div class=\"bb-variants\">\n\n\n            {% for variant in bb_product.variants %}\n\n              {% assign variant_image = variant.featured_image | default: bb_product.featured_image %}\n\n              <button\n                type=\"button\"\n                class=\"bb-variant\"\n\n                data-variant-id=\"{{ variant.id }}\"\n                data-title=\"{{ variant.title | escape }}\"\n                data-available=\"{{ variant.available }}\"\n\n                {% if variant_image %}\n                  data-image=\"{{ variant_image | image_url: width: 900 }}\"\n                {% else %}\n                  data-image=\"\"\n                {% endif %}\n\n                {% unless variant.available %}\n                  disabled\n                {% endunless %}\n              >\n\n\n                <div class=\"bb-variant-image-wrap\">\n\n                  {% if variant_image %}\n\n                    <img\n                      class=\"bb-variant-image\"\n\n                      src=\"{{ variant_image | image_url: width: 500 }}\"\n\n                      alt=\"{{ variant.title | escape }}\"\n\n                      loading=\"lazy\"\n\n                      width=\"500\"\n                      height=\"500\"\n                    >\n\n                  {% endif %}\n\n\n                  {% unless variant.available %}\n\n                    <span class=\"bb-sold-out\">\n                      אזל מהמלאי\n                    </span>\n\n                  {% endunless %}\n\n                </div>\n\n\n                <div class=\"bb-variant-info\">\n\n                  <span class=\"bb-variant-name\">\n                    {{ variant.title }}\n                  </span>\n\n\n                  {% if variant.available %}\n\n                    <span class=\"bb-add-label\">\n                      הוספה +\n                    </span>\n\n                  {% endif %}\n\n                </div>\n\n              </button>\n\n            {% endfor %}\n\n\n          </div>\n\n\n          <div class=\"bb-empty\">\n            לא נמצאו צבעים מתאימים\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  {% endif %}\n\n</div>\n\n\n<script>\n(function () {\n\n  const ROOT_ID = '{{ bb_root_id }}';\n\n\n  /* ========================================================\n     START\n  ======================================================== */\n\n  function bootBundleBuilder() {\n\n    const root =\n      document.getElementById(ROOT_ID);\n\n    if (!root) return;\n\n    if (\n      root.dataset.bbInitialized === 'true'\n    ) {\n      return;\n    }\n\n    root.dataset.bbInitialized = 'true';\n\n\n    /* ======================================================\n       BASIC DATA\n    ====================================================== */\n\n    const slotCount =\n      parseInt(\n        root.dataset.slotCount,\n        10\n      );\n\n    const allowDuplicates =\n      root.dataset.allowDuplicates === 'true';\n\n    const designMode =\n      root.dataset.designMode === 'true';\n\n\n    const slots =\n      Array.from(\n        root.querySelectorAll('.bb-slot')\n      );\n\n    const variantButtons =\n      Array.from(\n        root.querySelectorAll('.bb-variant')\n      );\n\n    const modal =\n      root.querySelector('.bb-modal');\n\n    const closeButton =\n      root.querySelector('.bb-modal-close');\n\n    const searchInput =\n      root.querySelector('.bb-search');\n\n    const countElement =\n      root.querySelector('.bb-selected-count');\n\n    const progressElement =\n      root.querySelector('.bb-progress');\n\n    const errorElement =\n      root.querySelector('.bb-error');\n\n    const emptyElement =\n      root.querySelector('.bb-empty');\n\n    const devMessage =\n      root.querySelector('.bb-dev-message');\n\n\n    if (\n      !slots.length ||\n      !variantButtons.length ||\n      !modal\n    ) {\n      return;\n    }\n\n\n    let activeSlot = 0;\n\n    let nativeProductForm = null;\n\n    let nativeSubmitButton = null;\n\n    let nativeScope = null;\n\n    let connectAttempts = 0;\n\n    let isAdding = false;\n\n\n    const selections =\n      new Array(slotCount).fill(null);\n\n\n\n    /* ======================================================\n       FIND ORIGINAL SHOPIFY BUY BUTTON\n    ====================================================== */\n\n    function findNativeProductForm() {\n\n      nativeScope =\n        root.closest('product-info') ||\n        root.closest('.shopify-section') ||\n        document;\n\n\n      const forms =\n        Array.from(\n          nativeScope.querySelectorAll(\n            'form[action*=\"/cart/add\"]'\n          )\n        );\n\n\n      nativeProductForm =\n        forms.find(function (form) {\n\n          const variantInput =\n            form.querySelector(\n              'input[name=\"id\"], select[name=\"id\"]'\n            );\n\n\n          const addButton =\n            form.querySelector(\n              'button[name=\"add\"], button[type=\"submit\"], input[type=\"submit\"]'\n            );\n\n\n          return (\n            variantInput &&\n            addButton\n          );\n\n        });\n\n\n      if (!nativeProductForm) {\n        return false;\n      }\n\n\n      nativeSubmitButton =\n        nativeProductForm.querySelector(\n          'button[name=\"add\"], button[type=\"submit\"], input[type=\"submit\"]'\n        );\n\n\n      if (!nativeSubmitButton) {\n        return false;\n      }\n\n\n      return true;\n\n    }\n\n\n\n    /* ======================================================\n       CONNECT TO ORIGINAL BUTTON\n    ====================================================== */\n\n    function connectNativeButton() {\n\n      connectAttempts++;\n\n\n      if (!findNativeProductForm()) {\n\n        if (connectAttempts < 30) {\n\n          setTimeout(\n            connectNativeButton,\n            150\n          );\n\n          return;\n        }\n\n\n        if (\n          designMode &&\n          devMessage\n        ) {\n\n          devMessage.textContent =\n            'לא נמצא כפתור הוספה לעגלה של Shopify. ודאי שהבלוק Buy buttons נמצא בתוך Product information.';\n\n          devMessage.classList.add(\n            'is-visible'\n          );\n\n        }\n\n\n        console.warn(\n          'Bundle Builder: Native Shopify product form was not found.'\n        );\n\n        return;\n      }\n\n\n      /*\n        כפתור Shopify המקורי נשאר הכפתור היחיד.\n        בהתחלה הוא נעול עד לבחירת כל הצבעים.\n      */\n\n      updateNativeButtonState();\n\n\n\n      /*\n        מיירטים את ה-submit המקורי,\n        כדי שהוא לא יוסיף רק Variant אחד.\n      */\n\n      nativeProductForm.addEventListener(\n        'submit',\n        handleNativeSubmit,\n        true\n      );\n\n\n      /*\n        אם יש Dynamic Checkout,\n        אנחנו מסתירים אותו כדי שלא יעקוף את הבאנדל.\n      */\n\n      const dynamicCheckout =\n        nativeScope.querySelector(\n          '.shopify-payment-button, [data-shopify=\"payment-button\"]'\n        );\n\n\n      if (dynamicCheckout) {\n\n        dynamicCheckout.style.display =\n          'none';\n\n      }\n\n    }\n\n\n\n    /* ======================================================\n       BUTTON STATE\n    ====================================================== */\n\n    function updateNativeButtonState() {\n\n      if (!nativeSubmitButton) {\n        return;\n      }\n\n\n      const complete =\n        selections.every(Boolean);\n\n\n      if (isAdding) {\n\n        nativeSubmitButton.disabled = true;\n\n        nativeSubmitButton.setAttribute(\n          'aria-disabled',\n          'true'\n        );\n\n        nativeSubmitButton.setAttribute(\n          'aria-busy',\n          'true'\n        );\n\n        return;\n      }\n\n\n      nativeSubmitButton.removeAttribute(\n        'aria-busy'\n      );\n\n\n      nativeSubmitButton.disabled =\n        !complete;\n\n\n      nativeSubmitButton.setAttribute(\n        'aria-disabled',\n        complete\n          ? 'false'\n          : 'true'\n      );\n\n    }\n\n\n\n    /* ======================================================\n       OPEN MODAL\n    ====================================================== */\n\n    function openModal(slotIndex) {\n\n      activeSlot = slotIndex;\n\n\n      modal.classList.add(\n        'is-open'\n      );\n\n\n      modal.setAttribute(\n        'aria-hidden',\n        'false'\n      );\n\n\n      document.body.style.overflow =\n        'hidden';\n\n\n      if (searchInput) {\n\n        searchInput.value = '';\n\n        filterVariants('');\n\n      }\n\n\n      refreshVariantStates();\n\n\n      setTimeout(function () {\n\n        if (searchInput) {\n          searchInput.focus();\n        }\n\n      }, 80);\n\n    }\n\n\n\n    /* ======================================================\n       CLOSE MODAL\n    ====================================================== */\n\n    function closeModal() {\n\n      modal.classList.remove(\n        'is-open'\n      );\n\n\n      modal.setAttribute(\n        'aria-hidden',\n        'true'\n      );\n\n\n      document.body.style.overflow =\n        '';\n\n    }\n\n\n\n    /* ======================================================\n       SLOT UI\n    ====================================================== */\n\n    function updateUI() {\n\n      slots.forEach(\n        function (slot, index) {\n\n          const selection =\n            selections[index];\n\n\n          const image =\n            slot.querySelector(\n              '.bb-slot-image'\n            );\n\n\n          const overlay =\n            slot.querySelector(\n              '.bb-slot-overlay'\n            );\n\n\n          if (selection) {\n\n            slot.classList.add(\n              'has-selection'\n            );\n\n\n            if (selection.image) {\n\n              image.src =\n                selection.image;\n\n            } else {\n\n              image.removeAttribute(\n                'src'\n              );\n\n            }\n\n\n            image.alt =\n              selection.title;\n\n\n            overlay.textContent =\n              selection.title;\n\n\n          } else {\n\n            slot.classList.remove(\n              'has-selection'\n            );\n\n\n            image.removeAttribute(\n              'src'\n            );\n\n\n            image.alt = '';\n\n            overlay.textContent = '';\n\n          }\n\n        }\n      );\n\n\n      const selectedCount =\n        selections.filter(Boolean).length;\n\n\n      if (countElement) {\n\n        countElement.textContent =\n          selectedCount;\n\n      }\n\n\n      if (progressElement) {\n\n        progressElement.classList.toggle(\n          'bb-complete',\n          selectedCount === slotCount\n        );\n\n      }\n\n\n      updateNativeButtonState();\n\n      refreshVariantStates();\n\n    }\n\n\n\n    /* ======================================================\n       ALREADY SELECTED / SOLD OUT\n    ====================================================== */\n\n    function refreshVariantStates() {\n\n      variantButtons.forEach(\n        function (button) {\n\n          const variantId =\n            button.dataset.variantId;\n\n\n          const available =\n            button.dataset.available ===\n            'true';\n\n\n          if (!available) {\n\n            button.disabled = true;\n\n            return;\n\n          }\n\n\n          const selectedElsewhere =\n            selections.some(\n              function (\n                selection,\n                index\n              ) {\n\n                return (\n                  selection &&\n                  selection.id === variantId &&\n                  index !== activeSlot\n                );\n\n              }\n            );\n\n\n          if (\n            !allowDuplicates &&\n            selectedElsewhere\n          ) {\n\n            button.disabled = true;\n\n          } else {\n\n            button.disabled = false;\n\n          }\n\n\n          const current =\n            selections[activeSlot];\n\n\n          button.classList.toggle(\n            'is-selected',\n\n            Boolean(\n              current &&\n              current.id === variantId\n            )\n          );\n\n        }\n      );\n\n    }\n\n\n\n    /* ======================================================\n       CLICK SLOT\n    ====================================================== */\n\n    slots.forEach(\n      function (slot) {\n\n        slot.addEventListener(\n          'click',\n          function () {\n\n            const index =\n              parseInt(\n                slot.dataset.slotIndex,\n                10\n              );\n\n\n            openModal(index);\n\n          }\n        );\n\n      }\n    );\n\n\n\n    /* ======================================================\n       SELECT VARIANT\n    ====================================================== */\n\n    variantButtons.forEach(\n      function (button) {\n\n        button.addEventListener(\n          'click',\n          function () {\n\n            if (button.disabled) {\n              return;\n            }\n\n\n            selections[activeSlot] = {\n\n              id:\n                button.dataset.variantId,\n\n              title:\n                button.dataset.title,\n\n              image:\n                button.dataset.image\n\n            };\n\n\n            hideError();\n\n            updateUI();\n\n            closeModal();\n\n          }\n        );\n\n      }\n    );\n\n\n\n    /* ======================================================\n       SEARCH\n    ====================================================== */\n\n    function filterVariants(query) {\n\n      const normalized =\n        query\n          .trim()\n          .toLocaleLowerCase();\n\n\n      let visibleCount = 0;\n\n\n      variantButtons.forEach(\n        function (button) {\n\n          const title =\n            (\n              button.dataset.title || ''\n            )\n            .toLocaleLowerCase();\n\n\n          const visible =\n            !normalized ||\n            title.includes(normalized);\n\n\n          button.style.display =\n            visible\n              ? ''\n              : 'none';\n\n\n          if (visible) {\n            visibleCount++;\n          }\n\n        }\n      );\n\n\n      if (emptyElement) {\n\n        emptyElement.style.display =\n          visibleCount\n            ? 'none'\n            : 'block';\n\n      }\n\n    }\n\n\n    if (searchInput) {\n\n      searchInput.addEventListener(\n        'input',\n        function () {\n\n          filterVariants(\n            searchInput.value\n          );\n\n        }\n      );\n\n    }\n\n\n\n    /* ======================================================\n       CLOSE EVENTS\n    ====================================================== */\n\n    if (closeButton) {\n\n      closeButton.addEventListener(\n        'click',\n        closeModal\n      );\n\n    }\n\n\n    modal.addEventListener(\n      'click',\n      function (event) {\n\n        if (event.target === modal) {\n\n          closeModal();\n\n        }\n\n      }\n    );\n\n\n    document.addEventListener(\n      'keydown',\n      function (event) {\n\n        if (\n          event.key === 'Escape' &&\n          modal.classList.contains(\n            'is-open'\n          )\n        ) {\n\n          closeModal();\n\n        }\n\n      }\n    );\n\n\n\n    /* ======================================================\n       ERROR HELPERS\n    ====================================================== */\n\n    function showError(message) {\n\n      if (!errorElement) return;\n\n\n      errorElement.textContent =\n        message;\n\n\n      errorElement.classList.add(\n        'is-visible'\n      );\n\n    }\n\n\n    function hideError() {\n\n      if (!errorElement) return;\n\n\n      errorElement.textContent = '';\n\n\n      errorElement.classList.remove(\n        'is-visible'\n      );\n\n    }\n\n\n\n    /* ======================================================\n       ORIGINAL SHOPIFY BUTTON SUBMIT\n    ====================================================== */\n\n    async function handleNativeSubmit(event) {\n\n      /*\n        אנחנו עוצרים את Add to Cart הרגיל של התמה.\n      */\n\n      event.preventDefault();\n\n      event.stopImmediatePropagation();\n\n\n      if (isAdding) {\n        return;\n      }\n\n\n      const complete =\n        selections.every(Boolean);\n\n\n      if (!complete) {\n\n        showError(\n          'בחרי את כל 4 הצבעים לפני ההוספה לעגלה.'\n        );\n\n        return;\n      }\n\n\n      hideError();\n\n\n      isAdding = true;\n\n      updateNativeButtonState();\n\n\n\n      /* ====================================================\n         UNIQUE BUNDLE ID\n      ==================================================== */\n\n      const bundleId =\n        'color-bundle-' +\n        Date.now().toString(36) +\n        '-' +\n        Math.random()\n          .toString(36)\n          .slice(2, 8);\n\n\n\n      /*\n        אם בעתיד נאפשר אותו צבע פעמיים,\n        נאחד אותו לכמות במקום לשלוח אותו Variant פעמיים.\n      */\n\n      const grouped =\n        {};\n\n\n      selections.forEach(\n        function (selection) {\n\n          if (!grouped[selection.id]) {\n\n            grouped[selection.id] = {\n\n              id:\n                Number(selection.id),\n\n              quantity:\n                0\n\n            };\n\n          }\n\n\n          grouped[selection.id].quantity++;\n\n        }\n      );\n\n\n\n      /* ====================================================\n         CART ITEMS\n      ==================================================== */\n\n      const items =\n        Object.values(grouped)\n          .map(\n            function (item) {\n\n              return {\n\n                id:\n                  item.id,\n\n                quantity:\n                  item.quantity,\n\n                properties: {\n\n                  \"_bundle_id\":\n                    bundleId,\n\n                  \"_bundle_type\":\n                    \"Color Bundle\"\n\n                }\n\n              };\n\n            }\n          );\n\n\n\n      /* ====================================================\n         AJAX CART\n      ==================================================== */\n\n      try {\n\n        const cartRoot =\n          (\n            window.Shopify &&\n            window.Shopify.routes &&\n            window.Shopify.routes.root\n          )\n            ? window.Shopify.routes.root\n            : '/';\n\n\n        const response =\n          await fetch(\n            cartRoot + 'cart/add.js',\n            {\n\n              method:\n                'POST',\n\n              headers: {\n\n                'Content-Type':\n                  'application/json',\n\n                'Accept':\n                  'application/json'\n\n              },\n\n              body:\n                JSON.stringify({\n                  items: items\n                })\n\n            }\n          );\n\n\n        let data = null;\n\n\n        try {\n\n          data =\n            await response.json();\n\n        } catch (jsonError) {\n\n          data = null;\n\n        }\n\n\n        if (!response.ok) {\n\n          let message =\n            'לא הצלחנו להוסיף את הסט לעגלה.';\n\n\n          if (\n            data &&\n            data.description\n          ) {\n\n            message =\n              data.description;\n\n          } else if (\n            data &&\n            data.message\n          ) {\n\n            message =\n              data.message;\n\n          }\n\n\n          throw new Error(message);\n\n        }\n\n\n\n        /* ==================================================\n           SUCCESS -> GO DIRECTLY TO CART\n        ================================================== */\n\n        window.location.assign(\n          cartRoot + 'cart'\n        );\n\n\n      } catch (error) {\n\n        console.error(\n          'Color Bundle Error:',\n          error\n        );\n\n\n        showError(\n          'לא הצלחנו להוסיף את הסט. ייתכן שאחד הצבעים שבחרת אזל מהמלאי. נסי לרענן את העמוד ולבחור שוב.'\n        );\n\n\n        isAdding = false;\n\n        updateNativeButtonState();\n\n      }\n\n    }\n\n\n\n    /* ======================================================\n       INITIAL UI\n    ====================================================== */\n\n    updateUI();\n\n    connectNativeButton();\n\n  }\n\n\n\n  /* ========================================================\n     INIT AFTER FULL DOM EXISTS\n     חשוב כי Buy buttons יכול להיות אחרי ה-Custom Liquid\n  ======================================================== */\n\n  function runInit() {\n\n    setTimeout(\n      bootBundleBuilder,\n      0\n    );\n\n  }\n\n\n  if (\n    document.readyState ===\n    'loading'\n  ) {\n\n    document.addEventListener(\n      'DOMContentLoaded',\n      runInit,\n      { once: true }\n    );\n\n  } else {\n\n    runInit();\n\n  }\n\n\n\n  /* ========================================================\n     SHOPIFY THEME EDITOR\n  ======================================================== */\n\n  document.addEventListener(\n    'shopify:section:load',\n    function () {\n\n      const root =\n        document.getElementById(\n          ROOT_ID\n        );\n\n\n      if (root) {\n\n        delete root.dataset.bbInitialized;\n\n        setTimeout(\n          bootBundleBuilder,\n          50\n        );\n\n      }\n\n    }\n  );\n\n})();\n</script>"
          }
        },
