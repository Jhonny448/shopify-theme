dal-inner {\n    position: relative;\n    width: min(430px, 92vw);\n    max-height: 88vh;\n    transform: scale(0.94);\n    transition: transform 0.25s ease;\n  }\n\n  .nail-story-modal.is-open .nail-story-modal-inner {\n    transform: scale(1);\n  }\n\n  .nail-story-modal-video {\n    display: block;\n    width: 100%;\n    max-height: 85vh;\n    object-fit: contain;\n    border-radius: 18px;\n    background: #000;\n    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);\n  }\n\n  .nail-story-modal-close {\n    position: absolute;\n    top: -14px;\n    left: -14px;\n    z-index: 10;\n    width: 38px;\n    height: 38px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 0;\n    border-radius: 50%;\n    background: #fff;\n    color: #111;\n    font-size: 24px;\n    line-height: 1;\n    cursor: pointer;\n    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);\n  }\n\n  /* MOBILE */\n\n  @media screen and (max-width: 749px) {\n\n    .nail-story-section {\n      padding: 10px 0;\n    }\n\n    .nail-story-wrapper {\n      gap: 14px;\n      padding: 0 18px;\n      box-sizing: border-box;\n    }\n\n    .nail-story-item {\n      width: 142px;\n      max-width: calc(50% - 7px);\n    }\n\n    .nail-story-circle {\n      width: 142px;\n      max-width: 100%;\n      height: auto;\n      aspect-ratio: 1 / 1;\n      padding: 5px;\n    }\n\n    .nail-story-circle::after {\n      inset: 5px;\n      border-width: 4px;\n    }\n\n    .nail-story-title {\n      margin-top: 9px;\n      font-size: 16px;\n      line-height: 1.3;\n      white-space: nowrap;\n    }\n\n    .nail-story-modal {\n      padding: 18px;\n    }\n\n    .nail-story-modal-inner {\n      width: min(390px, 90vw);\n    }\n\n    .nail-story-modal-video {\n      max-height: 82vh;\n      border-radius: 16px;\n    }\n\n    .nail-story-modal-close {\n      top: -12px;\n      left: -10px;\n      width: 36px;\n      height: 36px;\n      font-size: 22px;\n    }\n  }\n\n  @media screen and (max-width: 370px)