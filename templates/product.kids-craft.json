        "custom_liquid": "<style>\n  .polymer-section {\n    direction: ltr;\n    width: 100%;\n    box-sizing: border-box;\n\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n\n    background: #ffffff;\n\n    border: 1px solid #e7cfb5;\n    border-radius: 14px;\n\n    overflow: hidden;\n  }\n\n\n  /* =========================\n     IMAGE\n  ========================== */\n\n  .polymer-image {\n    width: 100%;\n    height: 100%;\n    min-height: 500px;\n  }\n\n  .polymer-image img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    object-position: center;\n  }\n\n\n  /* =========================\n     CONTENT\n  ========================== */\n\n  .polymer-content {\n    display: flex;\n    direction: rtl;\n    flex-direction: column;\n    justify-content: center;\n\n    padding: 52px 56px;\n\n    text-align: right;\n  }\n\n  .polymer-eyebrow {\n    margin: 0 0 12px;\n\n    font-size: 15px;\n    line-height: 1.4;\n    font-weight: 500;\n\n    color: #312b27;\n  }\n\n  .polymer-title {\n    margin: 0 0 38px;\n\n    font-size: 34px;\n    line-height: 1.2;\n    font-weight: 750;\n\n    color: #211c18;\n  }\n\n\n  /* =========================\n     BENEFITS\n  ========================== */\n\n  .polymer-benefits {\n    display: flex;\n    flex-direction: column;\n    gap: 28px;\n  }\n\n  .polymer-benefit {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n  }\n\n\n  /* CHECK ICON */\n  .polymer-check {\n    flex: 0 0 27px;\n\n    width: 27px;\n    height: 27px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    margin-top: 1px;\n\n    background: #f1e2d2;\n    border-radius: 6px;\n\n    color: #2c251f;\n  }\n\n  .polymer-check svg {\n    width: 15px;\n    height: 15px;\n    display: block;\n  }\n\n\n  .polymer-benefit-content {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .polymer-benefit-title {\n    margin: 0 0 5px;\n\n    font-size: 17px;\n    line-height: 1.4;\n    font-weight: 700;\n\n    color: #211c18;\n  }\n\n  .polymer-benefit-text {\n    margin: 0;\n\n    font-size: 16px;\n    line-height: 1.6;\n    font-weight: 400;\n\n    color: #625a54;\n  }\n\n\n  /* =========================\n     MOBILE\n  ========================== */\n\n  @media screen and (max-width: 749px) {\n\n    .polymer-section {\n      display: flex;\n      flex-direction: column;\n\n      border-radius: 12px;\n    }\n\n    /* תמונה קודם */\n    .polymer-image {\n      order: 1;\n\n      width: calc(100% - 20px);\n      margin: 10px 10px 0;\n\n      min-height: unset;\n      height: auto;\n\n      aspect-ratio: 1 / 1;\n\n      border-radius: 10px;\n      overflow: hidden;\n    }\n\n    .polymer-image img {\n      width: 100%;\n      height: 100%;\n\n      object-fit: cover;\n      object-position: center;\n\n      border-radius: 10px;\n    }\n\n    .polymer-content {\n      order: 2;\n\n      padding: 28px 20px 30px;\n    }\n\n    .polymer-eyebrow {\n      margin-bottom: 8px;\n\n      font-size: 12px;\n      line-height: 1.45;\n    }\n\n    .polymer-title {\n      margin-bottom: 27px;\n\n      font-size: 25px;\n      line-height: 1.2;\n    }\n\n    .polymer-benefits {\n      gap: 22px;\n    }\n\n    .polymer-benefit {\n      gap: 11px;\n    }\n\n    .polymer-check {\n      flex-basis: 23px;\n\n      width: 23px;\n      height: 23px;\n\n      border-radius: 5px;\n    }\n\n    .polymer-check svg {\n      width: 13px;\n      height: 13px;\n    }\n\n    .polymer-benefit-title {\n      margin-bottom: 3px;\n\n      font-size: 15px;\n      line-height: 1.4;\n    }\n\n    .polymer-benefit-text {\n      font-size: 14px;\n      line-height: 1.55;\n    }\n  }\n</style>\n\n\n<div class=\"polymer-section\" dir=\"rtl\">\n\n\n  <!-- =========================\n       IMAGE\n       כאן תכניס את ה-URL שלך\n  ========================== -->\n\n  <div class=\"polymer-image\">\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0825/1296/9956/files/hf_20260817_134405_7c1ad307-c0d0-4847-8038-2e7787ac3d49.webp?v=1786974359\"\n      alt=\"טכנולוגיית פולימר מוקשה מראש\"\n      loading=\"lazy\"\n    >\n\n  </div>\n\n\n  <!-- =========================\n       CONTENT\n  ========================== -->\n\n  <div class=\"polymer-content\">\n\n\n    <p class=\"polymer-eyebrow\">\n      בלי נזק. באיכות של מניקוריסטית.\n    </p>\n\n\n    <h2 class=\"polymer-title\">\n      טכנולוגיית פולימר<br>\n      מוקשה מראש\n    </h2>\n\n\n    <div class=\"polymer-benefits\">\n\n\n      <!-- 1 -->\n      <div class=\"polymer-benefit\">\n\n        <div class=\"polymer-check\" aria-hidden=\"true\">\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <path\n              d=\"M5 12.5L9.3 16.5L19 7\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </div>\n\n        <div class=\"polymer-benefit-content\">\n\n          <div class=\"polymer-benefit-title\">\n            מתקשה עוד לפני שהוא מגיע לציפורניים שלך\n          </div>\n\n          <p class=\"polymer-benefit-text\">\n            אין צורך ב־UV או בחומרים כימיים בזמן ההדבקה.\n          </p>\n\n        </div>\n\n      </div>\n\n\n      <!-- 2 -->\n      <div class=\"polymer-benefit\">\n\n        <div class=\"polymer-check\" aria-hidden=\"true\">\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <path\n              d=\"M5 12.5L9.3 16.5L19 7\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </div>\n\n        <div class=\"polymer-benefit-content\">\n\n          <div class=\"polymer-benefit-title\">\n            מגן על הציפורן הטבעית בזמן שהיא מתאוששת\n          </div>\n\n          <p class=\"polymer-benefit-text\">\n            ג׳ל גמיש שמגן על הציפורן בזמן שהיא מתאוששת ומתחזקת.\n          </p>\n\n        </div>\n\n      </div>\n\n\n      <!-- 3 -->\n      <div class=\"polymer-benefit\">\n\n        <div class=\"polymer-check\" aria-hidden=\"true\">\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <path\n              d=\"M5 12.5L9.3 16.5L19 7\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </div>\n\n        <div class=\"polymer-benefit-content\">\n\n          <div class=\"polymer-benefit-title\">\n            הסרה עדינה בעזרת שמן\n          </div>\n\n          <p class=\"polymer-benefit-text\">\n            בלי גירוד, בלי שיוף ובלי חומרים אגרסיביים.\n          </p>\n\n        </div>\n\n      </div>\n\n\n    </div>\n\n  </div>\n\n</div>",
