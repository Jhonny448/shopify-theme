s most of the screen\n  ========================================================= */\n  #{{ bb_modal_id }} .bb-modal-panel {\n    direction: rtl;\n    position: relative;\n    width: min(560px, calc(100vw - 24px));\n    height: auto;\n    max-height: min(94vh, 900px);\n    max-height: min(94dvh, 900px);\n    display: flex;\n    flex-direction: column;\n    margin: auto;\n    overflow: hidden;\n    background: #ffffff;\n    border-radius: 18px;\n    box-shadow: 0 24px 70px rgba(0,0,0,.28);\n    transform: translateY(8px) scale(.97);\n    transition: transform .22s ease;\n  }\n  #{{ bb_modal_id }}.is-open .bb-modal-panel {\n    transform: translateY(0) scale(1);\n  }\n\n  /* HEADER */\n  #{{ bb_modal_id }} .bb-modal-header {\n    flex: 0 0 auto;\n    min-height: 58px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 14px 18px;\n    background: #ffffff;\n    border-bottom: 1px solid #eee9e4;\n  }\n  #{{ bb_modal_id }} .bb-modal-title {\n    margin: 0;\n    font-size: 17px;\n    line-height: 1.2;\n    font-weight: 700;\n    color: #181512;\n  }\n  #{{ bb_modal_id }} .bb-modal-close {\n    flex: 0 0 32px;\n    width: 32px;\n    height: 32px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0;\n    margin: 0;\n    background: transparent;\n    border: 0;\n    border-radius: 50%;\n    font-family: Arial, sans-serif;\n    font-size: 24px;\n    font-weight: 300;\n    line-height: 1;\n    color: #191512;\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n  }\n  #{{ bb_modal_id }} .bb-modal-close:hover {\n    background: #f5f2ef;\n  }\n\n  /* MINI SLOTS */\n  #{{ bb_modal_id }} .bb-picker-top {\n    flex: 0 0 auto;\n    padding: 14px 18px 12px;\n    background: #ffffff;\n  }\n  #{{ bb_modal_id }} .bb-mini-title {\n    margin-bottom: 10px;\n    font-size: 11.5px;\n    line-height: 1.3;\n    font-weight: 600;\n    color: #504943;\n    text-align: center;\n  }\n  #{{ bb_modal_id }} .bb-mini-slots {\n    direction: rtl;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n  }\n  #{{ bb_modal_id }} .bb-mini-slot {\n    position: relative;\n    flex: 0 0 52px;\n    width: 52px;\n    height: 52px;\n    padding: 0;\n    overflow: hidden;\n    background: #ffffff;\n    border: 1px solid #ddd5ce;\n    border-radius: 8px;\n    cursor: default;\n    transition:\n      border-color .15s ease,\n      box-shadow .15s ease;\n  }\n  #{{ bb_modal_id }} .bb-mini-slot.has-selection {\n    cursor: pointer;\n    border-color: #201c19;\n  }\n  #{{ bb_modal_id }} .bb-mini-slot.is-next {\n    border-color: #201c19;\n    box-shadow: inset 0 0 0 1px #201c19;\n  }\n  #{{ bb_modal_id }} .bb-mini-slot::before,\n  #{{ bb_modal_id }} .bb-mini-slot::after {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 13px;\n    height: 1.2px;\n    background: #27221e;\n    transform: translate(-50%, -50%);\n    z-index: 1;\n  }\n  #{{ bb_modal_id }} .bb-mini-slot::after {\n    transform: translate(-50%, -50%) rotate(90deg);\n  }\n  #{{ bb_modal_id }} .bb-mini-slot-image {\n    display: none;\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    z-index: 2;\n  }\n  #{{ bb_modal_id }} .bb-mini-slot.has-selection .bb-mini-slot-image {\n    display: block;\n  }\n  /* small × on a filled mini slot */\n  #{{ bb_modal_id }} .bb-mini-remove {\n    display: none;\n    position: absolute;\n    top: 2px;\n    left: 2px;\n    z-index: 3;\n    width: 17px;\n    height: 17px;\n    align-items: center;\n    justify-content: center;\n    padding: 0;\n    background: rgba(255,255,255,.95);\n    border: 0;\n    border-radius: 50%;\n    box-shadow: 0 1px 4px rgba(0,0,0,.18);\n    font-family: Arial, sans-serif;\n    font-size: 13px;\n    line-height: 1;\n    color: #201c19;\n    cursor: pointer;\n  }\n  #{{ bb_modal_id }} .bb-mini-slot.has-selection .bb-mini-remove {\n    display: flex;\n  }\n\n  /* NOTE STRIP */\n  #{{ bb_modal_id }} .bb-modal-note {\n    flex: 0 0 auto;\n    margin: 0 18px;\n    padding: 11px 13px;\n    background: #f7f1eb;\n    border-radius: 8px;\n    font-size: 11.5px;\n    line-height: 1.4;\n    color: #332d28;\n    text-align: center;\n  }\n\n  /* =========================================================\n     HORIZONTAL VARIANT SCROLLER — flexes to fill the panel\n  ========================================================= */\n  #{{ bb_modal_id }} .bb-options-scroll {\n    direction: rtl;\n    flex: 1 1 auto;\n    min-height: 0;\n    width: 100%;\n    display: flex;\n    flex-direction: row;\n    flex-wrap: nowrap;\n    align-items: center;\n    gap: 11px;\n    overflow-x: auto !important;\n    overflow-y: hidden !important;\n    padding: 16px 18px 18px;\n    -webkit-overflow-scrolling: touch;\n    overscroll-behavior-x: contain;\n    scroll-snap-type: x proximity;\n    scrollbar-width: thin;\n  }\n  #{{ bb_modal_id }} .bb-options-scroll::-webkit-scrollbar {\n    height: 4px;\n  }\n  #{{ bb_modal_id }} .bb-options-scroll::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  #{{ bb_modal_id }} .bb-options-scroll::-webkit-scrollbar-thumb {\n    background: rgba(30,25,22,.16);\n    border-radius: 50px;\n  }\n\n  /* VARIANT CARD */\n  /* Card width scales with viewport height so the popup fills most\n     of the screen while the cards keep a natural photo proportion. */\n  #{{ bb_modal_id }} .bb-option {\n    position: relative;\n    flex: 0 0 clamp(125px, 26vh, 215px);\n    flex-basis: clamp(125px, 26dvh, 215px);\n    max-width: 62%;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 0;\n    margin: 0;\n    background: transparent;\n    border: 0;\n    text-align: center;\n    scroll-snap-align: start;\n    -webkit-tap-highlight-color: transparent;\n  }\n  #{{ bb_modal_id }} .bb-option-image-wrap {\n    position: relative;\n    flex: 0 0 auto;\n    width: 100%;\n    aspect-ratio: 0.8 / 1;\n    overflow: hidden;\n    background: #f1f0ef;\n    border-radius: 10px;\n    cursor: pointer;\n    transition: outline .15s ease;\n  }\n  #{{ bb_modal_id }} .bb-option-image {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n  }\n  #{{ bb_modal_id }} .bb-option.has-qty .bb-option-image-wrap {\n    outline: 2px solid #211d19;\n    outline-offset: -2px;\n  }\n  #{{ bb_modal_id }} .bb-option.is-unavailable .bb-option-image-wrap {\n    cursor: not-allowed;\n    opacity: .42;\n  }\n\n  /* CONTROLS ON THE IMAGE */\n  #{{ bb_modal_id }} .bb-option-controls {\n    position: absolute;\n    right: 8px;\n    bottom: 8px;\n    left: 8px;\n    z-index: 4;\n  }\n  #{{ bb_modal_id }} .bb-option-add {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    padding: 10px 8px;\n    background: #ffffff;\n    border: 0;\n    border-radius: 8px;\n    box-shadow: 0 2px 8px rgba(0,0,0,.08);\n    font-family: inherit;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 700;\n    color: #181512;\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n  }\n  #{{ bb_modal_id }} .bb-option-stepper {\n    /* keep − on the left and + on the right even inside RTL */\n    direction: ltr;\n    display: none;\n    align-items: center;\n    justify-content: space-between;\n    width: 100%;\n    padding: 4px 5px;\n    background: #ffffff;\n    border-radius: 8px;\n    box-shadow: 0 2px 8px rgba(0,0,0,.08);\n  }\n  #{{ bb_modal_id }} .bb-option.has-qty .bb-option-add {\n    display: none;\n  }\n  #{{ bb_modal_id }} .bb-option.has-qty .bb-option-stepper {\n    display: flex;\n  }\n  #{{ bb_modal_id }} .bb-step-btn {\n    flex: 0 0 26px;\n    width: 26px;\n    height: 26px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0;\n    background: transparent;\n    border: 0;\n    border-radius: 6px;\n    font-family: Arial, sans-serif;\n    font-size: 17px;\n    line-height: 1;\n    font-weight: 500;\n    color: #181512;\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n  }\n  #{{ bb_modal_id }} .bb-step-btn:hover:not(:disabled) {\n    background: #f3efec;\n  }\n  #{{ bb_modal_id }} .bb-step-btn:disabled {\n    opacity: .28;\n    cursor: not-allowed;\n  }\n  #{{ bb_modal_id }} .bb-step-qty {\n    flex: 1 1 auto;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 700;\n    color: #181512;\n    text-align: center;\n  }\n\n  #{{ bb_modal_id }} .bb-option-name {\n    display: block;\n    flex: 0 0 auto;\n    margin-top: 9px;\n    padding: 0 2px;\n    max-width: 100%;\n    overflow: hidden;\n    font-size: 11px;\n    line-height: 1.25;\n    font-weight: 700;\n    color: #201c19;\n    text-align: center;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n  }\n  #{{ bb_modal_id }} .bb-sold-out {\n    position: absolute;\n    top: 7px;\n    right: 7px;\n    z-index: 5;\n    padding: 5px 7px;\n    background: rgba(255,255,255,.94);\n    border-radius: 5px;\n    font-size: 9px;\n    line-height: 1;\n    font-weight: 700;\n    color: #655e58;\n  }\n\n  /* FOOTER */\n  #{{ bb_modal_id }} .bb-modal-footer {\n    flex: 0 0 auto;\n    padding: 13px 18px 16px;\n    background: #ffffff;\n    border-top: 1px solid #eee9e4;\n    text-align: center;\n  }\n  #{{ bb_modal_id }} .bb-modal-back {\n    padding: 0;\n    background: transparent;\n    border: 0;\n    border-bottom: 1px solid currentColor;\n    font-family: inherit;\n    font-size: 11.5px;\n    color: #302a26;\n    cursor: pointer;\n  }\n  #{{ bb_modal_id }} .bb-modal-error {\n    display: none;\n    margin: 0 18px 12px;\n    padding: 9px 11px;\n    background: #fff3f2;\n    border-radius: 7px;\n    font-size: 11.5px;\n    line-height: 1.45;\n    color: #a3322c;\n    text-align: center;\n  }\n  #{{ bb_modal_id }} .bb-modal-error.is-visible {\n    display: block;\n  }\n\n  /* LOADING OVERLAY (stays inside the popup) */\n  #{{ bb_modal_id }} .bb-loading {\n    position: absolute;\n    inset: 0;\n    z-index: 20;\n    display: none;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 13px;\n    background: rgba(255,255,255,.93);\n    -webkit-backdrop-filter: blur(2px);\n    backdrop-filter: blur(2px);\n  }\n  #{{ bb_modal_id }}.is-loading .bb-loading {\n    display: flex;\n  }\n  #{{ bb_modal_id }} .bb-spinner {\n    width: 30px;\n    height: 30px;\n    border: 2.5px solid #e2dbd4;\n    border-top-color: #201c19;\n    border-radius: 50%;\n    animation: bb-spin .7s linear infinite;\n  }\n  @keyframes bb-spin {\n    to { transform: rotate(360deg); }\n  }\n  #{{ bb_modal_id }} .bb-loading-text {\n    font-size: 12.5px;\n    font-weight: 600;\n    color: #2a2521;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #{{ bb_modal_id }} .bb-spinner { animation-duration: 2s; }\n    #{{ bb_modal_id }},\n    #{{ bb_modal_id }} .bb-modal-panel { transition: none; }\n  }\n\n  /* =========================================================\n     MOBILE\n  ========================================================= */\n  @media screen and (max-width: 749px) {\n    #{{ bb_root_id }} .bb-card {\n      padding: 12px;\n      border-radius: 10px;\n    }\n    #{{ bb_root_id }} .bb-title { font-size: 15.5px; }\n    #{{ bb_root_id }} .bb-subtitle { font-size: 11.5px; }\n\n    #{{ bb_modal_id }} {\n      padding: 10px !important;\n    }\n    #{{ bb_modal_id }} .bb-modal-panel {\n      width: min(440px, calc(100vw - 20px));\n      max-height: min(94vh, 860px);\n      max-height: min(94dvh, 860px);\n      border-radius: 16px;\n    }\n    #{{ bb_modal_id }} .bb-modal-header {\n      min-height: 54px;\n      padding: 12px 15px;\n    }\n    #{{ bb_modal_id }} .bb-modal-title { font-size: 15.5px; }\n    #{{ bb_modal_id }} .bb-picker-top { padding: 12px 14px 10px; }\n    #{{ bb_modal_id }} .bb-mini-title {\n      margin-bottom: 9px;\n      font-size: 10.5px;\n    }\n    #{{ bb_modal_id }} .bb-mini-slot {\n      flex-basis: 48px;\n      width: 48px;\n      height: 48px;\n    }\n    #{{ bb_modal_id }} .bb-modal-note {\n      margin: 0 14px;\n      padding: 10px 11px;\n      font-size: 10.5px;\n    }\n    #{{ bb_modal_id }} .bb-modal-error { margin: 0 14px 10px; }\n    #{{ bb_modal_id }} .bb-options-scroll {\n      gap: 9px;\n      padding: 14px 14px 16px;\n    }\n    /* ~2.2 cards visible so it is obvious you can swipe */\n    #{{ bb_modal_id }} .bb-option {\n      flex: 0 0 clamp(118px, 26vh, 200px);\n      flex-basis: clamp(118px, 26dvh, 200px);\n    }\n    #{{ bb_modal_id }} .bb-option-image-wrap {\n      border-radius: 9px;\n    }\n    #{{ bb_modal_id }} .bb-option-add {\n      padding: 9px 7px;\n      font-size: 10.5px;\n    }\n    #{{ bb_modal_id }} .bb-option-name {\n      margin-top: 8px;\n      font-size: 10.5px;\n    }\n    #{{ bb_modal_id }} .bb-modal-footer { padding: 12px 15px 14px; }\n  }\n</style>\n\n<div\n  id=\"{{ bb_root_id }}\"\n  data-slot-count=\"{{ bb_slot_count }}\"\n  data-allow-duplicates=\"{{ bb_allow_duplicates }}\"\n  data-button-opens-picker=\"{{ bb_button_opens_picker }}\"\n>\n  <!-- =====================================================\n       MAIN PICKER\n  ====================================================== -->\n  <div class=\"bb-card\">\n    <div class=\"bb-heading\">\n      <h3 class=\"bb-title\">\n        בחרי את הצבעים שלך\n      </h3>\n      <p class=\"bb-subtitle\">\n        בחרי {{ bb_slot_count }} צבעים וצרי את הסט שלך\n      </p>\n    </div>\n\n    <div class=\"bb-slots\">\n      {% for index in (1..bb_slot_count) %}\n        <button\n          type=\"button\"\n          class=\"bb-slot\"\n          data-slot-index=\"{{ forloop.index0 }}\"\n          aria-label=\"בחירת צבע {{ index }}\"\n        >\n          <span class=\"bb-slot-plus\"></span>\n          <img class=\"bb-slot-image\" alt=\"\">\n          <span class=\"bb-slot-name\"></span>\n        </button>\n      {% endfor %}\n    </div>\n\n    <div class=\"bb-slot-labels\">\n      {% for index in (1..bb_slot_count) %}\n        <div class=\"bb-slot-label\">\n          צבע {{ index }}\n        </div>\n      {% endfor %}\n    </div>\n\n    <div class=\"bb-progress\">\n      בחרת\n      <strong class=\"bb-count\">0</strong>\n      מתוך\n      <strong>{{ bb_slot_count }}</strong>\n      צבעים\n    </div>\n\n    <div class=\"bb-error\" role=\"alert\"></div>\n  </div>\n\n  <!-- =====================================================\n       POPUP  (moved to <body> on init — see JS)\n  ====================================================== -->\n  <div class=\"bb-modal\" aria-hidden=\"true\">\n    <div\n      class=\"bb-modal-panel\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"בחירת צבעים\"\n    >\n      <!-- HEADER -->\n      <div class=\"bb-modal-header\">\n        <h3 class=\"bb-modal-title\">\n          בחרי את הצבעים שלך\n        </h3>\n        <button\n          type=\"button\"\n          class=\"bb-modal-close\"\n          aria-label=\"סגירה\"\n        >\n          &times;\n        </button>\n      </div>\n\n      <!-- MINI SLOTS -->\n      <div class=\"bb-picker-top\">\n        <div class=\"bb-mini-title\">\n          בחרי {{ bb_slot_count }} צבעים לסט שלך\n        </div>\n        <div class=\"bb-mini-slots\">\n          {% for index in (1..bb_slot_count) %}\n            <div\n              class=\"bb-mini-slot\"\n              data-mini-slot-index=\"{{ forloop.index0 }}\"\n              aria-label=\"צבע {{ index }}\"\n            >\n              <img class=\"bb-mini-slot-image\" alt=\"\">\n              <button\n                type=\"button\"\n                class=\"bb-mini-remove\"\n                data-action=\"remove-slot\"\n                aria-label=\"הסרת צבע {{ index }}\"\n              >&times;</button>\n            </div>\n          {% endfor %}\n        </div>\n      </div>\n\n      <!-- NOTE -->\n      <div class=\"bb-modal-note\">\n        בחרי את הצבעים שאת הכי אוהבת — אפשר להוסיף אותו צבע כמה פעמים\n      </div>\n\n      <div class=\"bb-modal-error\" role=\"alert\"></div>\n\n      <!-- HORIZONTAL SCROLLER -->\n      <div class=\"bb-options-scroll\">\n        {% for variant in bb_product.variants %}\n          {% assign bb_image = variant.featured_image | default: bb_product.featured_image %}\n          <div\n            class=\"bb-option{% unless variant.available %} is-unavailable{% endunless %}\"\n            data-variant-id=\"{{ variant.id }}\"\n            data-title=\"{{ variant.title | escape }}\"\n            data-available=\"{{ variant.available }}\"\n            {% if bb_image %}\n              data-image=\"{{ bb_image | image_url: width: 400 }}\"\n            {% else %}\n              data-image=\"\"\n            {% endif %}\n          >\n            <div class=\"bb-option-image-wrap\">\n              {% if bb_image %}\n                <img\n                  class=\"bb-option-image\"\n                  src=\"{{ bb_image | image_url: width: 500 }}\"\n                  alt=\"{{ variant.title | escape }}\"\n                  loading=\"lazy\"\n                  width=\"500\"\n                  height=\"600\"\n                >\n              {% endif %}\n\n              {% if variant.available %}\n                <div class=\"bb-option-controls\">\n                  <button\n                    type=\"button\"\n                    class=\"bb-option-add\"\n                    data-action=\"add\"\n                  >\n                    הוספה +\n                  </button>\n                  <div class=\"bb-option-stepper\">\n                    <button\n                      type=\"button\"\n                      class=\"bb-step-btn\"\n                      data-action=\"minus\"\n                      aria-label=\"הפחתת כמות\"\n                    >&minus;</button>\n                    <span class=\"bb-step-qty\">0</span>\n                    <button\n                      type=\"button\"\n                      class=\"bb-step-btn\"\n                      data-action=\"plus\"\n                      aria-label=\"הוספת כמות\"\n                    >+</button>\n                  </div>\n                </div>\n              {% else %}\n                <span class=\"bb-sold-out\">\n                  אזל מהמלאי\n                </span>\n              {% endif %}\n            </div>\n\n            <span class=\"bb-option-name\">\n              {{ variant.title }}\n            </span>\n          </div>\n        {% endfor %}\n      </div>\n\n      <!-- FOOTER -->\n      <div class=\"bb-modal-footer\">\n        <button type=\"button\" class=\"bb-modal-back\">\n          חזרה לעמוד המוצר\n        </button>\n      </div>\n\n      <!-- LOADING -->\n      <div class=\"bb-loading\">\n        <div class=\"bb-spinner\"></div>\n        <div class=\"bb-loading-text\">מוסיפים את הסט לעגלה…</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var ROOT_ID  = '{{ bb_root_id }}';\n  var MODAL_ID = '{{ bb_modal_id }}';\n\n  function initBundleBuilder() {\n    var root = document.getElementById(ROOT_ID);\n    if (!root || root.dataset.bbInit === '1') { return; }\n    root.dataset.bbInit = '1';\n\n    /* =====================================================\n       CONFIG\n    ===================================================== */\n    var slotCount        = parseInt(root.getAttribute('data-slot-count'), 10) || 4;\n    var allowDuplicates  = root.getAttribute('data-allow-duplicates') === 'true';\n    var buttonOpensPicker = root.getAttribute('data-button-opens-picker') === 'true';\n\n    /* =====================================================\n       PORTAL THE MODAL TO <body>\n       An ancestor of the root uses transform (scroll-reveal\n       animation), which turns position:fixed into\n       position-relative-to-that-ancestor. Moving the modal to\n       <body> is the only reliable fix.\n    ===================================================== */\n    var modal = root.querySelector('.bb-modal');\n    if (!modal) { return; }\n\n    var orphan = document.getElementById(MODAL_ID);\n    if (orphan && orphan !== modal && orphan.parentNode) {\n      orphan.parentNode.removeChild(orphan);\n    }\n    modal.id = MODAL_ID;\n    document.body.appendChild(modal);\n\n    /* =====================================================\n       DOM\n    ===================================================== */\n    var slots     = Array.prototype.slice.call(root.querySelectorAll('.bb-slot'));\n    var count     = root.querySelector('.bb-count');\n    var progress  = root.querySelector('.bb-progress');\n    var errorBox  = root.querySelector('.bb-error');\n\n    var miniSlots  = Array.prototype.slice.call(modal.querySelectorAll('.bb-mini-slot'));\n    var options    = Array.prototype.slice.call(modal.querySelectorAll('.bb-option'));\n    var scroller   = modal.querySelector('.bb-options-scroll');\n    var modalClose = modal.querySelector('.bb-modal-close');\n    var modalBack  = modal.querySelector('.bb-modal-back');\n    var modalError = modal.querySelector('.bb-modal-error');\n\n    /* =====================================================\n       STATE\n    ===================================================== */\n    var selections   = new Array(slotCount).fill(null);\n    var adding       = false;\n    var bodyOverflow = '';\n    var productForm  = null;\n    var addButton    = null;\n\n    /* =====================================================\n       HELPERS\n    ===================================================== */\n    function totalSelected() {\n      var n = 0;\n      for (var i = 0; i < selections.length; i++) { if (selections[i]) { n++; } }\n      return n;\n    }\n\n    function isComplete() {\n      return totalSelected() === slotCount;\n    }\n\n    function qtyOf(id) {\n      var n = 0;\n      for (var i = 0; i < selections.length; i++) {\n        if (selections[i] && selections[i].id === id) { n++; }\n      }\n      return n;\n    }\n\n    function addOne(data) {\n      if (isComplete()) {\n        setError('כבר בחרת ' + slotCount + ' צבעים. אפשר להסיר צבע כדי להחליף.');\n        return false;\n      }\n      if (!allowDuplicates && qtyOf(data.id) > 0) { return false; }\n      var free = selections.indexOf(null);\n      if (free === -1) { return false; }\n      selections[free] = data;\n      return true;\n    }\n\n    function removeOne(id) {\n      for (var i = selections.length - 1; i >= 0; i--) {\n        if (selections[i] && selections[i].id === id) {\n          selections.splice(i, 1);\n          selections.push(null);\n          return true;\n        }\n      }\n      return false;\n    }\n\n    function removeAt(index) {\n      if (!selections[index]) { return false; }\n      selections.splice(index, 1);\n      selections.push(null);\n      return true;\n    }\n\n    function setError(message) {\n      var text = message || '';\n      if (errorBox) {\n        errorBox.textContent = text;\n        errorBox.classList.toggle('is-visible', Boolean(text));\n      }\n      if (modalError) {\n        modalError.textContent = text;\n        modalError.classList.toggle('is-visible', Boolean(text));\n      }\n    }\n\n    function isModalOpen() {\n      return modal.classList.contains('is-open');\n    }\n\n    function setLoading(loading) {\n      modal.classList.toggle('is-loading', Boolean(loading));\n      if (addButton) {\n        if (loading) {\n          addButton.setAttribute('aria-busy', 'true');\n          addButton.classList.add('loading');\n        } else {\n          addButton.removeAttribute('aria-busy');\n          addButton.classList.remove('loading');\n        }\n      }\n    }\n\n    /* =====================================================\n       RENDER\n    ===================================================== */\n    function updateUI() {\n      /* main slots */\n      slots.forEach(function (slot, index) {\n        var item  = selections[index];\n        var image = slot.querySelector('.bb-slot-image');\n        var name  = slot.querySelector('.bb-slot-name');\n        if (item) {\n          slot.classList.add('has-selection');\n          if (item.image) { image.setAttribute('src', item.image); }\n          else { image.removeAttribute('src'); }\n          image.setAttribute('alt', item.title || '');\n          name.textContent = item.title || '';\n        } else {\n          slot.classList.remove('has-selection');\n          image.removeAttribute('src');\n          image.setAttribute('alt', '');\n          name.textContent = '';\n        }\n      });\n\n      /* mini slots */\n      var nextEmpty = selections.indexOf(null);\n      miniSlots.forEach(function (mini, index) {\n        var item  = selections[index];\n        var image = mini.querySelector('.bb-mini-slot-image');\n        if (item) {\n          mini.classList.add('has-selection');\n          if (item.image) { image.setAttribute('src', item.image); }\n          else { image.removeAttribute('src'); }\n          image.setAttribute('alt', item.title || '');\n        } else {\n          mini.classList.remove('has-selection');\n          image.removeAttribute('src');\n          image.setAttribute('alt', '');\n        }\n        mini.classList.toggle('is-next', index === nextEmpty);\n      });\n\n      /* option cards */\n      var full = isComplete();\n      options.forEach(function (option) {\n        var available = option.getAttribute('data-available') === 'true';\n        if (!available) { return; }\n\n        var id  = option.getAttribute('data-variant-id');\n        var qty = qtyOf(id);\n\n        option.classList.toggle('has-qty', qty > 0);\n\n        var qtyEl = option.querySelector('.bb-step-qty');\n        if (qtyEl) { qtyEl.textContent = qty; }\n\n        var plus  = option.querySelector('[data-action=\"plus\"]');\n        var addBtn = option.querySelector('[data-action=\"add\"]');\n        var blocked = full || (!allowDuplicates && qty > 0);\n        if (plus)   { plus.disabled = blocked; }\n        if (addBtn) { addBtn.disabled = blocked; }\n      });\n\n      /* progress */\n      var selectedCount = totalSelected();\n      if (count) { count.textContent = selectedCount; }\n      if (progress) { progress.classList.toggle('is-complete', full); }\n\n      syncNativeButton();\n    }\n\n    /* =====================================================\n       MODAL\n    ===================================================== */\n    function openModal() {\n      if (isModalOpen()) { return; }\n      bodyOverflow = document.body.style.overflow;\n      modal.classList.add('is-open');\n      modal.setAttribute('aria-hidden', 'false');\n      document.body.style.overflow = 'hidden';\n      updateUI();\n      if (scroller) {\n        window.requestAnimationFrame(function () { scroller.scrollLeft = 0; });\n      }\n      if (modalClose) {\n        window.setTimeout(function () {\n          try { modalClose.focus({ preventScroll: true }); } catch (e) {}\n        }, 60);\n      }\n    }\n\n    function closeModal(restoreScroll) {\n      modal.classList.remove('is-open');\n      modal.setAttribute('aria-hidden', 'true');\n      if (restoreScroll !== false) {\n        document.body.style.overflow = bodyOverflow;\n      }\n    }\n\n    function resetBuilder() {\n      adding = false;\n      selections = new Array(slotCount).fill(null);\n      setError('');\n      updateUI();\n    }\n\n    /* =====================================================\n       CART DRAWER\n       This store runs Cartify, which HIDES the theme's native\n       Dawn drawer (#CartDrawer) via CSS and renders its own\n       <dialog class=\"cartify-drawer\">. Opening the native one\n       would lock the page behind an invisible drawer, so the\n       order below matters. Never navigate to /cart.\n    ===================================================== */\n    function elVisible(el) {\n      if (!el || !el.isConnected) { return false; }\n      var s = window.getComputedStyle(el);\n      if (s.display === 'none' || s.visibility === 'hidden') { return false; }\n      if (Number(s.opacity) === 0) { return false; }\n      return true;\n    }\n\n    function anyDrawerOpen() {\n      var dialogs = document.querySelectorAll('dialog[open]');\n      for (var i = 0; i < dialogs.length; i++) {\n        var cls = String(dialogs[i].className || '') + ' ' + String(dialogs[i].id || '');\n        if (/cart|drawer|minicart/i.test(cls)) { return true; }\n      }\n      if (document.querySelector('cart-drawer.active, cart-drawer.is-open, .cart-drawer.active, .drawer--cart.is-open')) {\n        return true;\n      }\n      return false;\n    }\n\n    function clickCartToggle() {\n      var toggle = document.querySelector(\n        '[data-cart-drawer-toggle], [aria-controls=\"cart-drawer\"], [aria-controls=\"CartDrawer\"], ' +\n        '#cart-icon-bubble, .header__icon--cart, a[href$=\"/cart\"]'\n      );\n      if (!toggle) { return false; }\n\n      /* Hard-block any navigation this synthetic click might cause.\n         If a drawer app handles the click, it still opens. */\n      var guard = function (ev) {\n        var link = ev.target && ev.target.closest ? ev.target.closest('a') : null;\n        if (link) { ev.preventDefault(); }\n      };\n      document.addEventListener('click', guard, true);\n      try { toggle.click(); } catch (e) {}\n      window.setTimeout(function () {\n        document.removeEventListener('click', guard, true);\n      }, 50);\n      return true;\n    }\n\n    async function openCartDrawer() {\n      /* Cartify (and most drawer apps) auto-open after /cart/add.js.\n         Give it a beat, then bail out early if it already did. */\n      await new Promise(function (resolve) {\n        window.requestAnimationFrame(function () {\n          window.requestAnimationFrame(function () {\n            window.setTimeout(resolve, 320);\n          });\n        });\n      });\n      if (anyDrawerOpen()) { return true; }\n\n      /* 1) Cartify drawer */\n      var cartify = document.querySelector('dialog.cartify-drawer, .cartify-drawer, [class*=\"cartify-drawer\"]');\n      if (cartify) {\n        if (cartify.open === true) { return true; }\n        if (typeof cartify.showModal === 'function') {\n          try { cartify.showModal(); if (cartify.open) { return true; } } catch (e) {}\n        }\n        if (typeof cartify.show === 'function') {\n          try { cartify.show(); if (cartify.open) { return true; } } catch (e) {}\n        }\n      }\n\n      /* 2) Shopify Horizon theme-drawer */\n      var horizon = document.querySelector('theme-drawer#cart-drawer, theme-drawer[id*=\"cart\"]');\n      if (horizon) {\n        try {\n          if (window.customElements && customElements.whenDefined) {\n            await customElements.whenDefined('theme-drawer');\n          }\n        } catch (e) {}\n        if (typeof horizon.open === 'function') { horizon.open(); return true; }\n        var horizonDialog = horizon.querySelector('dialog');\n        if (horizonDialog && typeof horizonDialog.showModal === 'function' && !horizonDialog.open) {\n          try { horizonDialog.showModal(); return true; } catch (e) {}\n        }\n      }\n\n      /* 3) Dawn cart-drawer — ONLY if it is actually visible.\n            Apps like Cartify hide it; opening it then would lock\n            body scroll behind an invisible panel. */\n      var dawn = document.querySelector('cart-drawer');\n      if (dawn && typeof dawn.open === 'function' && elVisible(dawn)) {\n        var inner = dawn.querySelector('#CartDrawer, .cart-drawer__inner, .drawer__inner');\n        if (!inner || elVisible(inner)) {\n          try { dawn.open(); return true; } catch (e) {}\n        }\n      }\n\n      /* 4) Shopify standard action */\n      if (window.Shopify && window.Shopify.actions && typeof Shopify.actions.openCart === 'function') {\n        try { await Shopify.actions.openCart(); return true; } catch (e) {}\n      }\n\n      /* 5) Last resort: click the header cart toggle, navigation blocked */\n      return clickCartToggle();\n    }\n\n    /* =====================================================\n       ADD TO CART\n       Uses the classic Ajax API on purpose: Cartify (and most\n       drawer/upsell apps) patch window.fetch and listen for\n       /cart/add.js. Shopify.actions.updateCart bypasses that\n       hook, which is why the drawer never opened before.\n    ===================================================== */\n    async function addToCart(items) {\n      var rootUrl = (window.Shopify && Shopify.routes && Shopify.routes.root)\n        ? Shopify.routes.root\n        : '/';\n\n      var payload = { items: items };\n\n      /* Ask for the theme's cart sections so native drawers can\n         re-render themselves without a second request. */\n      var dawn = document.querySelector('cart-drawer');\n      if (dawn && typeof dawn.getSectionsToRender === 'function') {\n        try {\n          var ids = dawn.getSectionsToRender().map(function (s) { return s.id; });\n          if (ids && ids.length) {\n            payload.sections = ids;\n            payload.sections_url = window.location.pathname;\n          }\n        } catch (e) {}\n      }\n\n      var response = await fetch(rootUrl + 'cart/add.js', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Accept': 'application/json',\n          'X-Requested-With': 'XMLHttpRequest'\n        },\n        body: JSON.stringify(payload)\n      });\n\n      var data = {};\n      try { data = await response.json(); } catch (e) {}\n\n      if (!response.ok) {\n        throw new Error(\n          data.description || data.message ||\n          'לא הצלחנו להוסיף את הסט לעגלה.'\n        );\n      }\n\n      /* Nudge every refresh mechanism we know of. */\n      ['cart:refresh', 'cart:update', 'cart-drawer:refresh'].forEach(function (name) {\n        try {\n          document.dispatchEvent(new CustomEvent(name, {\n            bubbles: true,\n            detail: { source: 'color-bundle-builder' }\n          }));\n        } catch (e) {}\n      });\n\n      if (window.Shopify && window.Shopify.actions && typeof Shopify.actions.getCart === 'function') {\n        try { await Shopify.actions.getCart(); } catch (e) {}\n      }\n\n      return data;\n    }\n\n    /* =====================================================\n       SUBMIT BUNDLE\n       Fires automatically the moment the 4th colour is picked.\n       The popup stays on screen with a loading state, then the\n       cart drawer opens over it.\n    ===================================================== */\n    async function submitBundle() {\n      if (adding) { return; }\n      if (!isComplete()) {\n        setError('בחרי את כל ' + slotCount + ' הצבעים לפני ההוספה לעגלה.');\n        return;\n      }\n\n      adding = true;\n      setError('');\n      setLoading(true);\n      syncNativeButton();\n\n      var bundleId = 'color-bundle-' +\n        Date.now().toString(36) + '-' +\n        Math.random().toString(36).slice(2, 8);\n\n      var grouped = {};\n      var order   = [];\n      selections.forEach(function (item) {\n        if (!grouped[item.id]) {\n          grouped[item.id] = { id: item.id, quantity: 0 };\n          order.push(item.id);\n        }\n        grouped[item.id].quantity += 1;\n      });\n\n      var items = order.map(function (key) {\n        return {\n          id: Number(grouped[key].id),\n          quantity: grouped[key].quantity,\n          properties: {\n            _bundle_id: bundleId,\n            _bundle_type: 'Color Bundle'\n          }\n        };\n      });\n\n      try {\n        await addToCart(items);\n\n        await openCartDrawer();\n\n        setLoading(false);\n        /* Close the popup behind the drawer and always release OUR\n           scroll lock. Verified on this store: Cartify locks scrolling\n           with <html class=\"cartify-drawer-open\">, not with an inline\n           body style, so releasing ours cannot unlock the drawer — but\n           keeping ours would leave the page frozen after it closes. */\n        closeModal(true);\n        resetBuilder();\n      } catch (error) {\n        setLoading(false);\n        adding = false;\n        syncNativeButton();\n        setError(\n          error && error.message\n            ? error.message\n            : 'לא הצלחנו להוסיף את הסט לעגלה. נסי שוב.'\n        );\n      }\n    }\n\n    /* =====================================================\n       EVENTS — main card slots\n    ===================================================== */\n    slots.forEach(function (slot) {\n      slot.addEventListener('click', function () {\n        setError('');\n        openModal();\n      });\n    });\n\n    /* =====================================================\n       EVENTS — mini slots (click a filled one to remove it)\n    ===================================================== */\n    miniSlots.forEach(function (mini, index) {\n      mini.addEventListener('click', function () {\n        if (adding) { return; }\n        if (removeAt(index)) {\n          setError('');\n          updateUI();\n        }\n      });\n    });\n\n    /* =====================================================\n       EVENTS — colour cards (delegated)\n    ===================================================== */\n    if (scroller) {\n      scroller.addEventListener('click', function (event) {\n        if (adding) { return; }\n\n        var target = event.target;\n        if (!target || !target.closest) { return; }\n\n        var option = target.closest('.bb-option');\n        if (!option) { return; }\n        if (option.getAttribute('data-available') !== 'true') { return; }\n\n        var control = target.closest('[data-action]');\n        var action  = control ? control.getAttribute('data-action') : 'add';\n        if (control && control.disabled) { return; }\n\n        var id = option.getAttribute('data-variant-id');\n\n        if (action === 'minus') {\n          if (removeOne(id)) { setError(''); updateUI(); }\n          return;\n        }\n\n        var data = {\n          id: id,\n          title: option.getAttribute('data-title') || '',\n          image: option.getAttribute('data-image') || ''\n        };\n\n        if (addOne(data)) {\n          setError('');\n          updateUI();\n          /* All slots filled -> straight to cart + drawer,\n             without leaving the popup. */\n          if (isComplete()) { submitBundle(); }\n        }\n      });\n    }\n\n    /* =====================================================\n       EVENTS — close\n    ===================================================== */\n    if (modalClose) {\n      modalClose.addEventListener('click', function () { closeModal(); });\n    }\n    if (modalBack) {\n      modalBack.addEventListener('click', function () { closeModal(); });\n    }\n    modal.addEventListener('click', function (event) {\n      if (event.target === modal && !adding) { closeModal(); }\n    });\n    document.addEventListener('keydown', function (event) {\n      if (event.key === 'Escape' && isModalOpen() && !adding) { closeModal(); }\n    });\n\n    /* =====================================================\n       NATIVE SHOPIFY BUY BUTTON\n    ===================================================== */\n    function findProductForm() {\n      var scope =\n        root.closest('product-info') ||\n        root.closest('product-form-component') ||\n        root.closest('.shopify-section') ||\n        document;\n\n      var forms = Array.prototype.slice.call(\n        scope.querySelectorAll('form[action*=\"/cart/add\"]')\n      );\n\n      productForm = forms.find(function (form) {\n        return form.querySelector('[name=\"id\"]') &&\n          form.querySelector('button[name=\"add\"], button[type=\"submit\"], input[type=\"submit\"]');\n      }) || null;\n\n      addButton = productForm\n        ? productForm.querySelector('button[name=\"add\"], button[type=\"submit\"], input[type=\"submit\"]')\n        : null;\n\n      return Boolean(productForm && addButton);\n    }\n\n    function syncNativeButton() {\n      if (!addButton) { return; }\n\n      if (buttonOpensPicker) {\n        /* The button is the way INTO the picker, so it must stay\n           clickable even with 0 colours chosen. */\n        if (!adding && addButton.disabled) {\n          addButton.disabled = false;\n          addButton.removeAttribute('disabled');\n          addButton.setAttribute('aria-disabled', 'false');\n        }\n        return;\n      }\n\n      var disabled = adding || !isComplete();\n      addButton.disabled = disabled;\n      addButton.setAttribute('aria-disabled', disabled ? 'true' : 'false');\n      if (disabled) {\n        addButton.setAttribute('disabled', 'disabled');\n      } else {\n        addButton.removeAttribute('disabled');\n      }\n    }\n\n    function onNativeSubmit(event) {\n      event.preventDefault();\n      event.stopImmediatePropagation();\n      if (adding) { return; }\n      setError('');\n      if (isComplete()) { submitBundle(); }\n      else { openModal(); }\n    }\n\n    var tries = 0;\n    function connectButton() {\n      tries += 1;\n      if (!findProductForm()) {\n        if (tries < 40) { window.setTimeout(connectButton, 150); }\n        return;\n      }\n\n      var scope =\n        root.closest('product-info') ||\n        root.closest('.shopify-section') ||\n        document;\n\n      /* Hide Buy It Now so it cannot bypass the bundle. */\n      var dynamicCheckout = scope.querySelector(\n        '.shopify-payment-button, [data-shopify=\"payment-button\"]'\n      );\n      if (dynamicCheckout) { dynamicCheckout.style.display = 'none'; }\n\n      productForm.addEventListener('submit', onNativeSubmit, true);\n      /* Some themes trigger add-to-cart on click, not submit. */\n      addButton.addEventListener('click', function (event) {\n        if (event.defaultPrevented) { return; }\n        onNativeSubmit(event);\n      }, true);\n\n      /* Keep our state authoritative when the theme re-renders\n         the button after variant changes. */\n      var syncing = false;\n      var observer = new MutationObserver(function () {\n        if (syncing) { return; }\n        syncing = true;\n        window.setTimeout(function () {\n          syncNativeButton();\n          syncing = false;\n        }, 0);\n      });\n      observer.observe(addButton, {\n        attributes: true,\n        attributeFilter: ['disabled', 'aria-disabled', 'aria-busy', 'class']\n      });\n\n      syncNativeButton();\n    }\n\n    /* =====================================================\n       START\n    ===================================================== */\n    updateUI();\n    connectButton();\n\n    /* bfcache / back button */\n    window.addEventListener('pageshow', function () {\n      adding = false;\n      setLoading(false);\n      findProductForm();\n      updateUI();\n    });\n\n    /* Theme editor: drop the portaled modal when the section reloads */\n    document.addEventListener('shopify:section:unload', function (event) {\n      if (event.target && event.target.contains && event.target.contains(root)) {\n        if (modal && modal.parentNode) { modal.parentNode.removeChild(modal); }\n      }\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initBundleBuilder, { once: true });\n  } else {\n    initBundleBuilder();\n  }\n})();\n</script>"
          }
        },
