======= */\n\n#{{ bb_modal_id }} .bb-modal-panel {\n  direction: rtl;\n\n  position: relative;\n\n  width:\n    min(500px, calc(100vw - 32px));\n\n  max-width: 500px;\n\n  height: auto !important;\n  max-height: none !important;\n\n  margin: 0 !important;\n\n  display: flex;\n  flex-direction: column;\n\n  overflow: hidden !important;\n\n  background: #ffffff;\n\n  border-radius: 16px;\n\n  box-shadow:\n    0 24px 75px rgba(0,0,0,.26);\n\n  transform:\n    translateY(5px)\n    scale(.97);\n\n  transition:\n    transform .2s ease;\n}\n\n#{{ bb_modal_id }}.is-open .bb-modal-panel {\n  transform:\n    translateY(0)\n    scale(1);\n}\n\n\n/* =========================================================\n   POPUP HEADER\n========================================================= */\n\n#{{ bb_modal_id }} .bb-modal-header {\n  flex: 0 0 auto;\n\n  min-height: 54px;\n\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 12px;\n\n  padding: 12px 15px;\n\n  background: #ffffff;\n\n  border-bottom:\n    1px solid #eee9e4;\n}\n\n#{{ bb_modal_id }} .bb-modal-title {\n  margin: 0;\n\n  font-size: 16px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  color: #181512;\n}\n\n\n/* =========================================================\n   X\n========================================================= */\n\n#{{ bb_modal_id }} .bb-modal-close {\n  flex: 0 0 30px;\n\n  width: 30px;\n  height: 30px;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  padding: 0;\n  margin: 0;\n\n  background: transparent;\n\n  border: 0;\n  border-radius: 50%;\n\n  font-family: Arial, sans-serif;\n\n  font-size: 23px;\n  font-weight: 300;\n  line-height: 1;\n\n  color: #191512;\n\n  cursor: pointer;\n\n  -webkit-tap-highlight-color: transparent;\n}\n\n#{{ bb_modal_id }} .bb-modal-close:hover {\n  background: #f5f2ef;\n}\n\n\n/* =========================================================\n   MINI SLOTS\n========================================================= */\n\n#{{ bb_modal_id }} .bb-picker-top {\n  flex: 0 0 auto;\n\n  padding:\n    12px\n    14px\n    11px;\n\n  background: #ffffff;\n}\n\n#{{ bb_modal_id }} .bb-mini-title {\n  margin-bottom: 9px;\n\n  font-size: 11px;\n  line-height: 1.3;\n  font-weight: 600;\n\n  color: #504943;\n\n  text-align: center;\n}\n\n#{{ bb_modal_id }} .bb-mini-slots {\n  direction: ltr;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 7px;\n}\n\n#{{ bb_modal_id }} .bb-mini-slot {\n  position: relative;\n\n  flex: 0 0 46px;\n\n  width: 46px;\n  height: 46px;\n\n  padding: 0;\n\n  overflow: hidden;\n\n  background: #ffffff;\n\n  border: 1px solid #ddd5ce;\n  border-radius: 7px;\n\n  cursor: pointer;\n\n  transition:\n    border-color .15s ease,\n    box-shadow .15s ease;\n}\n\n#{{ bb_modal_id }} .bb-mini-slot.is-active {\n  border-color: #201c19;\n\n  box-shadow:\n    inset 0 0 0 1px #201c19;\n}\n\n#{{ bb_modal_id }} .bb-mini-slot::before,\n#{{ bb_modal_id }} .bb-mini-slot::after {\n  content: \"\";\n\n  position: absolute;\n\n  top: 50%;\n  left: 50%;\n\n  width: 12px;\n  height: 1.2px;\n\n  background: #27221e;\n\n  transform:\n    translate(-50%, -50%);\n\n  z-index: 1;\n}\n\n#{{ bb_modal_id }} .bb-mini-slot::after {\n  transform:\n    translate(-50%, -50%)\n    rotate(90deg);\n}\n\n#{{ bb_modal_id }} .bb-mini-slot-image {\n  display: none;\n\n  position: absolute;\n  inset: 0;\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n\n  z-index: 2;\n}\n\n#{{ bb_modal_id }} .bb-mini-slot.has-selection .bb-mini-slot-image {\n  display: block;\n}\n\n\n/* =========================================================\n   SMALL MESSAGE\n========================================================= */\n\n#{{ bb_modal_id }} .bb-modal-note {\n  flex: 0 0 auto;\n\n  margin:\n    0\n    14px;\n\n  padding:\n    9px\n    11px;\n\n  background: #f7f1eb;\n\n  border-radius: 7px;\n\n  font-size: 10.5px;\n  line-height: 1.35;\n\n  color: #332d28;\n\n  text-align: center;\n}\n\n\n/* =========================================================\n   HORIZONTAL SCROLLER — NO VERTICAL SCROLL\n========================================================= */\n\n#{{ bb_modal_id }} .bb-options-scroll {\n  direction: ltr;\n\n  width: 100%;\n\n  flex: 0 0 auto;\n\n  overflow-x: auto !important;\n  overflow-y: hidden !important;\n\n  padding:\n    13px\n    14px\n    14px;\n\n  margin: 0 !important;\n\n  -webkit-overflow-scrolling: touch;\n\n  overscroll-behavior-x: contain;\n\n  scroll-snap-type:\n    x proximity;\n\n  scrollbar-width: thin;\n}\n\n#{{ bb_modal_id }} .bb-options-scroll::-webkit-scrollbar {\n  height: 4px;\n}\n\n#{{ bb_modal_id }} .bb-options-scroll::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n#{{ bb_modal_id }} .bb-options-scroll::-webkit-scrollbar-thumb {\n  background:\n    rgba(30,25,22,.18);\n\n  border-radius: 50px;\n}\n\n\n/* =========================================================\n   CAROUSEL\n========================================================= */\n\n#{{ bb_modal_id }} .bb-options {\n  display: flex;\n\n  flex-direction: row;\n  flex-wrap: nowrap;\n\n  align-items: flex-start;\n\n  gap: 10px;\n\n  width: max-content;\n  min-width: 100%;\n\n  padding: 0;\n  margin: 0;\n}\n\n\n/* =========================================================\n   VARIANT CARD\n========================================================= */\n\n#{{ bb_modal_id }} .bb-option {\n  position: relative;\n\n  flex:\n    0 0 145px;\n\n  width: 145px;\n  min-width: 145px;\n\n  padding: 0;\n  margin: 0;\n\n  overflow: visible;\n\n  background: transparent;\n\n  border: 0;\n  border-radius: 0;\n\n  box-shadow: none;\n\n  text-align: center;\n\n  cursor: pointer;\n\n  scroll-snap-align: start;\n\n  -webkit-tap-highlight-color: transparent;\n}\n\n#{{ bb_modal_id }} .bb-option:active:not(:disabled) {\n  transform: scale(.985);\n}\n\n\n/* IMAGE */\n\n#{{ bb_modal_id }} .bb-option-image-wrap {\n  position: relative;\n\n  width: 145px;\n  height: 165px;\n\n  overflow: hidden;\n\n  background: #f1f0ef;\n\n  border-radius: 9px;\n\n  transition:\n    outline .15s ease;\n}\n\n#{{ bb_modal_id }} .bb-option-image {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n  object-position: center;\n}\n\n#{{ bb_modal_id }} .bb-option.is-selected .bb-option-image-wrap {\n  outline:\n    2px solid #211d19;\n\n  outline-offset: -2px;\n}\n\n\n/* =========================================================\n   ADD +\n========================================================= */\n\n#{{ bb_modal_id }} .bb-add-label {\n  position: absolute;\n\n  right: 8px;\n  bottom: 8px;\n\n  z-index: 4;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  min-width: 68px;\n\n  padding:\n    9px\n    11px;\n\n  background: #ffffff;\n\n  border-radius: 7px;\n\n  box-shadow:\n    0 2px 8px rgba(0,0,0,.07);\n\n  font-size: 10.5px;\n  line-height: 1;\n\n  font-weight: 700;\n\n  color: #181512;\n}\n\n\n/* NAME */\n\n#{{ bb_modal_id }} .bb-option-name {\n  display: block;\n\n  max-width: 100%;\n\n  margin-top: 9px;\n\n  padding: 0 2px;\n\n  overflow: hidden;\n\n  font-size: 10.5px;\n  line-height: 1.25;\n\n  font-weight: 700;\n\n  color: #201c19;\n\n  text-align: center;\n\n  white-space: nowrap;\n\n  text-overflow: ellipsis;\n}\n\n\n/* =========================================================\n   SOLD OUT\n========================================================= */\n\n#{{ bb_modal_id }} .bb-option:disabled {\n  cursor: not-allowed;\n\n  opacity: .42;\n}\n\n#{{ bb_modal_id }} .bb-sold-out {\n  position: absolute;\n\n  top: 7px;\n  right: 7px;\n\n  z-index: 5;\n\n  padding:\n    5px\n    7px;\n\n  background:\n    rgba(255,255,255,.94);\n\n  border-radius: 5px;\n\n  font-size: 9px;\n  line-height: 1;\n\n  font-weight: 700;\n\n  color: #655e58;\n}\n\n\n/* =========================================================\n   FOOTER\n========================================================= */\n\n#{{ bb_modal_id }} .bb-modal-footer {\n  flex: 0 0 auto;\n\n  padding:\n    12px\n    14px\n    14px;\n\n  background: #ffffff;\n\n  border-top:\n    1px solid #eee9e4;\n\n  text-align: center;\n}\n\n#{{ bb_modal_id }} .bb-modal-back {\n  padding: 0;\n\n  background: transparent;\n\n  border: 0;\n\n  border-bottom:\n    1px solid currentColor;\n\n  font-family: inherit;\n\n  font-size: 11px;\n\n  color: #302a26;\n\n  cursor: pointer;\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  #{{ bb_root_id }} .bb-card {\n    padding: 12px;\n\n    border-radius: 10px;\n  }\n\n  #{{ bb_root_id }} .bb-title {\n    font-size: 15.5px;\n  }\n\n  #{{ bb_root_id }} .bb-subtitle {\n    font-size: 11.5px;\n  }\n\n\n  /* EXACTLY CENTER OF VIEWPORT */\n\n  #{{ bb_modal_id }} {\n    display: grid !important;\n\n    place-items: center !important;\n\n    width: 100vw !important;\n    height: 100dvh !important;\n\n    padding: 14px !important;\n  }\n\n\n  #{{ bb_modal_id }} .bb-modal-panel {\n    width:\n      min(320px, calc(100vw - 28px));\n\n    max-width: 320px;\n\n    height: auto !important;\n    max-height: none !important;\n\n    margin: 0 !important;\n\n    border-radius: 15px;\n  }\n\n\n  #{{ bb_modal_id }} .bb-modal-header {\n    min-height: 50px;\n\n    padding:\n      10px\n      13px;\n  }\n\n\n  #{{ bb_modal_id }} .bb-modal-title {\n    font-size: 14.5px;\n  }\n\n\n  #{{ bb_modal_id }} .bb-picker-top {\n    padding:\n      10px\n      11px\n      9px;\n  }\n\n\n  #{{ bb_modal_id }} .bb-mini-title {\n    margin-bottom: 7px;\n\n    font-size: 9.5px;\n  }\n\n\n  #{{ bb_modal_id }} .bb-mini-slot {\n    flex-basis: 42px;\n\n    width: 42px;\n    height: 42px;\n  }\n\n\n  #{{ bb_modal_id }} .bb-modal-note {\n    margin:\n      0\n      11px;\n\n    padding:\n      8px\n      9px;\n\n    font-size: 9.5px;\n  }\n\n\n  /* HORIZONTAL ONLY */\n\n  #{{ bb_modal_id }} .bb-options-scroll {\n    overflow-x: auto !important;\n    overflow-y: hidden !important;\n\n    padding:\n      12px\n      11px\n      13px;\n\n    margin: 0 !important;\n  }\n\n\n  #{{ bb_modal_id }} .bb-options {\n    display: flex;\n\n    flex-wrap: nowrap;\n\n    gap: 8px;\n\n    width: max-content;\n    min-width: 100%;\n  }\n\n\n  /*\n    approximately 2 full cards + piece of third\n    like competitor reference\n  */\n\n  #{{ bb_modal_id }} .bb-option {\n    flex:\n      0 0 116px;\n\n    width: 116px;\n    min-width: 116px;\n  }\n\n\n  #{{ bb_modal_id }} .bb-option-image-wrap {\n    width: 116px;\n    height: 138px;\n\n    border-radius: 8px;\n  }\n\n\n  #{{ bb_modal_id }} .bb-add-label {\n    right: 7px;\n    bottom: 7px;\n\n    min-width: 61px;\n\n    padding:\n      8px\n      8px;\n\n    font-size: 9.5px;\n  }\n\n\n  #{{ bb_modal_id }} .bb-option-name {\n    margin-top: 7px;\n\n    font-size: 9.5px;\n  }\n\n\n  #{{ bb_modal_id }} .bb-modal-footer {\n    padding:\n      10px\n      13px\n      12px;\n  }\n\n}\n\n</style>\n\n\n<!-- =========================================================\n     MAIN BUNDLE BUILDER\n========================================================= -->\n\n<div\n  id=\"{{ bb_root_id }}\"\n  data-slot-count=\"{{ bb_slot_count }}\"\n  data-allow-duplicates=\"{{ bb_allow_duplicates }}\"\n>\n\n  <div class=\"bb-card\">\n\n\n    <div class=\"bb-heading\">\n\n      <h3 class=\"bb-title\">\n        בחרי את הצבעים שלך\n      </h3>\n\n      <p class=\"bb-subtitle\">\n        בחרי 4 צבעים וצרי את הסט שלך\n      </p>\n\n    </div>\n\n\n    <div class=\"bb-slots\">\n\n      {% for index in (1..bb_slot_count) %}\n\n        <button\n          type=\"button\"\n          class=\"bb-slot\"\n          data-slot-index=\"{{ forloop.index0 }}\"\n          aria-label=\"בחירת צבע {{ index }}\"\n        >\n\n          <span class=\"bb-slot-plus\"></span>\n\n          <img\n            class=\"bb-slot-image\"\n            alt=\"\"\n          >\n\n          <span class=\"bb-slot-name\"></span>\n\n        </button>\n\n      {% endfor %}\n\n    </div>\n\n\n    <div class=\"bb-slot-labels\">\n\n      {% for index in (1..bb_slot_count) %}\n\n        <div class=\"bb-slot-label\">\n          צבע {{ index }}\n        </div>\n\n      {% endfor %}\n\n    </div>\n\n\n    <div class=\"bb-progress\">\n\n      בחרת\n\n      <strong class=\"bb-count\">\n        0\n      </strong>\n\n      מתוך\n\n      <strong>\n        4\n      </strong>\n\n      צבעים\n\n    </div>\n\n\n    <div\n      class=\"bb-error\"\n      role=\"alert\"\n    ></div>\n\n  </div>\n\n</div>\n\n\n<!-- =========================================================\n     POPUP\n     JS WILL MOVE THIS ELEMENT DIRECTLY UNDER <body>\n========================================================= -->\n\n<div\n  id=\"{{ bb_modal_id }}\"\n  class=\"bb-modal\"\n  aria-hidden=\"true\"\n>\n\n  <div\n    class=\"bb-modal-panel\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-label=\"בחירת צבעים\"\n  >\n\n\n    <!-- HEADER -->\n\n    <div class=\"bb-modal-header\">\n\n      <h3 class=\"bb-modal-title\">\n        בחרי את הצבעים שלך\n      </h3>\n\n      <button\n        type=\"button\"\n        class=\"bb-modal-close\"\n        aria-label=\"סגירה\"\n      >\n        ×\n      </button>\n\n    </div>\n\n\n    <!-- 4 MINI SLOTS -->\n\n    <div class=\"bb-picker-top\">\n\n      <div class=\"bb-mini-title\">\n        בחרי 4 צבעים לסט שלך\n      </div>\n\n\n      <div class=\"bb-mini-slots\">\n\n        {% for index in (1..bb_slot_count) %}\n\n          <button\n            type=\"button\"\n            class=\"bb-mini-slot\"\n            data-mini-slot-index=\"{{ forloop.index0 }}\"\n            aria-label=\"צבע {{ index }}\"\n          >\n\n            <img\n              class=\"bb-mini-slot-image\"\n              alt=\"\"\n            >\n\n          </button>\n\n        {% endfor %}\n\n      </div>\n\n    </div>\n\n\n    <!-- MESSAGE -->\n\n    <div class=\"bb-modal-note\">\n      בחרי את הצבעים שאת הכי אוהבת — אפשר להחליף כל בחירה לפני ההוספה לעגלה\n    </div>\n\n\n    <!-- HORIZONTAL VARIANTS -->\n\n    <div class=\"bb-options-scroll\">\n\n      <div class=\"bb-options\">\n\n\n        {% for variant in bb_product.variants %}\n\n          {% assign bb_image = variant.featured_image | default: bb_product.featured_image %}\n\n\n          <button\n            type=\"button\"\n            class=\"bb-option\"\n\n            data-variant-id=\"{{ variant.id }}\"\n\n            data-variant-gid=\"gid://shopify/ProductVariant/{{ variant.id }}\"\n\n            data-title=\"{{ variant.title | escape }}\"\n\n            data-available=\"{{ variant.available }}\"\n\n            {% if bb_image %}\n              data-image=\"{{ bb_image | image_url: width: 900 }}\"\n            {% else %}\n              data-image=\"\"\n            {% endif %}\n\n            {% unless variant.available %}\n              disabled\n            {% endunless %}\n          >\n\n\n            <div class=\"bb-option-image-wrap\">\n\n\n              {% if bb_image %}\n\n                <img\n                  class=\"bb-option-image\"\n\n                  src=\"{{ bb_image | image_url: width: 500 }}\"\n\n                  alt=\"{{ variant.title | escape }}\"\n\n                  loading=\"lazy\"\n\n                  width=\"500\"\n                  height=\"500\"\n                >\n\n              {% endif %}\n\n\n              {% if variant.available %}\n\n                <span class=\"bb-add-label\">\n                  הוספה +\n                </span>\n\n              {% else %}\n\n                <span class=\"bb-sold-out\">\n                  אזל מהמלאי\n                </span>\n\n              {% endif %}\n\n\n            </div>\n\n\n            <span class=\"bb-option-name\">\n              {{ variant.title }}\n            </span>\n\n\n          </button>\n\n\n        {% endfor %}\n\n\n      </div>\n\n    </div>\n\n\n    <!-- FOOTER -->\n\n    <div class=\"bb-modal-footer\">\n\n      <button\n        type=\"button\"\n        class=\"bb-modal-back\"\n      >\n        חזרה לעמוד המוצר\n      </button>\n\n    </div>\n\n\n  </div>\n\n</div>\n\n\n<script>\n\n(function () {\n\n  var ROOT_ID =\n    '{{ bb_root_id }}';\n\n  var MODAL_ID =\n    '{{ bb_modal_id }}';\n\n\n\n  function initBundleBuilder() {\n\n\n    var root =\n      document.getElementById(\n        ROOT_ID\n      );\n\n\n    var modal =\n      document.getElementById(\n        MODAL_ID\n      );\n\n\n    if (\n      !root ||\n      !modal ||\n      root.dataset.bbInit === '1'\n    ) {\n      return;\n    }\n\n\n    root.dataset.bbInit =\n      '1';\n\n\n\n    /* =====================================================\n       CRITICAL POPUP FIX\n       Move modal directly under BODY.\n\n       This prevents Product Information,\n       transforms, contain, overflow etc.\n       from affecting position:fixed.\n    ===================================================== */\n\n    if (\n      modal.parentElement !==\n      document.body\n    ) {\n\n      document.body.appendChild(\n        modal\n      );\n\n    }\n\n\n\n    /* =====================================================\n       DATA\n    ===================================================== */\n\n    var slotCount =\n      parseInt(\n        root.getAttribute(\n          'data-slot-count'\n        ),\n        10\n      ) || 4;\n\n\n    var allowDuplicates =\n      root.getAttribute(\n        'data-allow-duplicates'\n      ) === 'true';\n\n\n\n    /* =====================================================\n       ELEMENTS\n    ===================================================== */\n\n    var slots =\n      Array.prototype.slice.call(\n        root.querySelectorAll(\n          '.bb-slot'\n        )\n      );\n\n\n    var miniSlots =\n      Array.prototype.slice.call(\n        modal.querySelectorAll(\n          '.bb-mini-slot'\n        )\n      );\n\n\n    var options =\n      Array.prototype.slice.call(\n        modal.querySelectorAll(\n          '.bb-option'\n        )\n      );\n\n\n    var modalClose =\n      modal.querySelector(\n        '.bb-modal-close'\n      );\n\n\n    var modalBack =\n      modal.querySelector(\n        '.bb-modal-back'\n      );\n\n\n    var scroller =\n      modal.querySelector(\n        '.bb-options-scroll'\n      );\n\n\n    var count =\n      root.querySelector(\n        '.bb-count'\n      );\n\n\n    var progress =\n      root.querySelector(\n        '.bb-progress'\n      );\n\n\n    var errorBox =\n      root.querySelector(\n        '.bb-error'\n      );\n\n\n\n    /* =====================================================\n       STATE\n    ===================================================== */\n\n    var selections =\n      new Array(\n        slotCount\n      ).fill(null);\n\n\n    var activeSlot =\n      0;\n\n\n    var adding =\n      false;\n\n\n    var bodyOverflow =\n      '';\n\n\n    var htmlOverflow =\n      '';\n\n\n    var productForm =\n      null;\n\n\n    var addButton =\n      null;\n\n\n    var syncingButton =\n      false;\n\n\n    var buttonObserver =\n      null;\n\n\n\n    /* =====================================================\n       HELPERS\n    ===================================================== */\n\n    function delay(ms) {\n\n      return new Promise(\n        function (resolve) {\n\n          window.setTimeout(\n            resolve,\n            ms\n          );\n\n        }\n      );\n\n    }\n\n\n    function nextPaint() {\n\n      return new Promise(\n        function (resolve) {\n\n          window.requestAnimationFrame(\n            function () {\n\n              window.requestAnimationFrame(\n                resolve\n              );\n\n            }\n          );\n\n        }\n      );\n\n    }\n\n\n\n    /* =====================================================\n       FIND ORIGINAL SHOPIFY PRODUCT FORM\n    ===================================================== */\n\n    function findProductForm() {\n\n\n      var scope =\n\n        root.closest(\n          'product-info'\n        ) ||\n\n        root.closest(\n          'product-form-component'\n        ) ||\n\n        root.closest(\n          '.shopify-section'\n        ) ||\n\n        document;\n\n\n\n      var forms =\n        Array.prototype.slice.call(\n\n          scope.querySelectorAll(\n            'form[action*=\"/cart/add\"]'\n          )\n\n        );\n\n\n\n      productForm =\n        forms.find(\n          function (form) {\n\n            return (\n\n              form.querySelector(\n                '[name=\"id\"]'\n              ) &&\n\n              form.querySelector(\n                'button[name=\"add\"], button[type=\"submit\"], input[type=\"submit\"]'\n              )\n\n            );\n\n          }\n        ) || null;\n\n\n\n      addButton =\n\n        productForm\n\n          ? productForm.querySelector(\n              'button[name=\"add\"], button[type=\"submit\"], input[type=\"submit\"]'\n            )\n\n          : null;\n\n\n\n      return Boolean(\n        productForm &&\n        addButton\n      );\n\n    }\n\n\n\n    /* =====================================================\n       ERROR\n    ===================================================== */\n\n    function setError(message) {\n\n      if (!errorBox) {\n        return;\n      }\n\n\n      errorBox.textContent =\n        message || '';\n\n\n      errorBox.classList.toggle(\n        'is-visible',\n        Boolean(message)\n      );\n\n    }\n\n\n\n    /* =====================================================\n       COMPLETE?\n    ===================================================== */\n\n    function isComplete() {\n\n      return selections.every(\n        function (item) {\n\n          return Boolean(\n            item\n          );\n\n        }\n      );\n\n    }\n\n\n\n    /* =====================================================\n       ORIGINAL ADD TO CART BUTTON\n    ===================================================== */\n\n    function updateButton() {\n\n      if (!addButton) {\n        return;\n      }\n\n\n      syncingButton =\n        true;\n\n\n      var disabled =\n        adding ||\n        !isComplete();\n\n\n      addButton.disabled =\n        disabled;\n\n\n      addButton.setAttribute(\n        'aria-disabled',\n        disabled\n          ? 'true'\n          : 'false'\n      );\n\n\n      if (disabled) {\n\n        addButton.setAttribute(\n          'disabled',\n          'disabled'\n        );\n\n      } else {\n\n        addButton.removeAttribute(\n          'disabled'\n        );\n\n\n        addButton.removeAttribute(\n          'aria-busy'\n        );\n\n\n        addButton.classList.remove(\n          'loading'\n        );\n\n      }\n\n\n      window.setTimeout(\n        function () {\n\n          syncingButton =\n            false;\n\n        },\n        0\n      );\n\n    }\n\n\n\n    /* =====================================================\n       OPTIONS STATE\n    ===================================================== */\n\n    function refreshOptions() {\n\n\n      options.forEach(\n        function (button) {\n\n\n          var available =\n            button.getAttribute(\n              'data-available'\n            ) === 'true';\n\n\n          var id =\n            button.getAttribute(\n              'data-variant-id'\n            );\n\n\n          var usedElsewhere =\n            selections.some(\n              function (\n                item,\n                index\n              ) {\n\n                return (\n\n                  item &&\n\n                  item.id === id &&\n\n                  index !==\n                    activeSlot\n\n                );\n\n              }\n            );\n\n\n          button.disabled =\n\n            !available ||\n\n            (\n              !allowDuplicates &&\n              usedElsewhere\n            );\n\n\n          button.classList.toggle(\n            'is-selected',\n\n            Boolean(\n\n              selections[\n                activeSlot\n              ] &&\n\n              selections[\n                activeSlot\n              ].id === id\n\n            )\n          );\n\n        }\n      );\n\n\n      miniSlots.forEach(\n        function (\n          mini,\n          index\n        ) {\n\n          mini.classList.toggle(\n            'is-active',\n            index === activeSlot\n          );\n\n        }\n      );\n\n    }\n\n\n\n    /* =====================================================\n       UPDATE UI\n    ===================================================== */\n\n    function updateUI() {\n\n\n      slots.forEach(\n        function (\n          slot,\n          index\n        ) {\n\n\n          var item =\n            selections[index];\n\n\n          var image =\n            slot.querySelector(\n              '.bb-slot-image'\n            );\n\n\n          var name =\n            slot.querySelector(\n              '.bb-slot-name'\n            );\n\n\n          if (item) {\n\n\n            slot.classList.add(\n              'has-selection'\n            );\n\n\n            if (item.image) {\n\n              image.setAttribute(\n                'src',\n                item.image\n              );\n\n            } else {\n\n              image.removeAttribute(\n                'src'\n              );\n\n            }\n\n\n            image.setAttribute(\n              'alt',\n              item.title || ''\n            );\n\n\n            name.textContent =\n              item.title || '';\n\n\n          } else {\n\n\n            slot.classList.remove(\n              'has-selection'\n            );\n\n\n            image.removeAttribute(\n              'src'\n            );\n\n\n            image.setAttribute(\n              'alt',\n              ''\n            );\n\n\n            name.textContent =\n              '';\n\n          }\n\n        }\n      );\n\n\n\n      miniSlots.forEach(\n        function (\n          mini,\n          index\n        ) {\n\n\n          var item =\n            selections[index];\n\n\n          var image =\n            mini.querySelector(\n              '.bb-mini-slot-image'\n            );\n\n\n          if (\n            item &&\n            item.image\n          ) {\n\n\n            mini.classList.add(\n              'has-selection'\n            );\n\n\n            image.setAttribute(\n              'src',\n              item.image\n            );\n\n\n            image.setAttribute(\n              'alt',\n              item.title || ''\n            );\n\n\n          } else {\n\n\n            mini.classList.remove(\n              'has-selection'\n            );\n\n\n            image.removeAttribute(\n              'src'\n            );\n\n\n            image.setAttribute(\n              'alt',\n              ''\n            );\n\n          }\n\n        }\n      );\n\n\n\n      var selectedCount =\n        selections.filter(\n          function (item) {\n\n            return Boolean(\n              item\n            );\n\n          }\n        ).length;\n\n\n\n      if (count) {\n\n        count.textContent =\n          selectedCount;\n\n      }\n\n\n\n      if (progress) {\n\n        progress.classList.toggle(\n          'is-complete',\n          selectedCount ===\n            slotCount\n        );\n\n      }\n\n\n\n      updateButton();\n\n      refreshOptions();\n\n    }\n\n\n\n    /* =====================================================\n       OPEN POPUP\n    ===================================================== */\n\n    function openModal(index) {\n\n\n      activeSlot =\n        index;\n\n\n      bodyOverflow =\n        document.body.style.overflow;\n\n\n      htmlOverflow =\n        document.documentElement.style.overflow;\n\n\n      modal.classList.add(\n        'is-open'\n      );\n\n\n      modal.setAttribute(\n        'aria-hidden',\n        'false'\n      );\n\n\n      document.body.style.overflow =\n        'hidden';\n\n\n      document.documentElement.style.overflow =\n        'hidden';\n\n\n      refreshOptions();\n\n\n\n      if (scroller) {\n\n        window.requestAnimationFrame(\n          function () {\n\n            scroller.scrollLeft =\n              0;\n\n          }\n        );\n\n      }\n\n    }\n\n\n\n    /* =====================================================\n       CLOSE POPUP\n    ===================================================== */\n\n    function closeModal() {\n\n\n      modal.classList.remove(\n        'is-open'\n      );\n\n\n      modal.setAttribute(\n        'aria-hidden',\n        'true'\n      );\n\n\n      document.body.style.overflow =\n        bodyOverflow;\n\n\n      document.documentElement.style.overflow =\n        htmlOverflow;\n\n    }\n\n\n\n    /* =====================================================\n       RESET BUILDER\n    ===================================================== */\n\n    function resetBuilder() {\n\n\n      adding =\n        false;\n\n\n      activeSlot =\n        0;\n\n\n      selections =\n        new Array(\n          slotCount\n        ).fill(null);\n\n\n      setError(\n        ''\n      );\n\n\n      updateUI();\n\n    }\n\n\n\n    /* =====================================================\n       NATIVE BUTTON LOADING\n    ===================================================== */\n\n    function showNativeLoading(\n      loading\n    ) {\n\n\n      if (!addButton) {\n        return;\n      }\n\n\n      adding =\n        loading;\n\n\n      if (loading) {\n\n\n        addButton.setAttribute(\n          'aria-busy',\n          'true'\n        );\n\n\n        addButton.classList.add(\n          'loading'\n        );\n\n\n      } else {\n\n\n        addButton.removeAttribute(\n          'aria-busy'\n        );\n\n\n        addButton.classList.remove(\n          'loading'\n        );\n\n      }\n\n\n      updateButton();\n\n    }\n\n\n\n    /* =====================================================\n       HORIZON NATIVE AUTO-OPEN\n       \n       Horizon's cart-drawer-component only automatically\n       opens after an ADD when it has the auto-open attribute.\n    ===================================================== */\n\n    function primeNativeDrawerAutoOpen() {\n\n\n      var component =\n        document.querySelector(\n          '#cart-drawer cart-drawer-component'\n        );\n\n\n      if (component) {\n\n        component.setAttribute(\n          'auto-open',\n          ''\n        );\n\n      }\n\n    }\n\n\n\n    /* =====================================================\n       FORCE OPEN REAL NATIVE CART DRAWER\n\n       IMPORTANT:\n       fresh DOM query every retry because Shopify may\n       rerender/replace the drawer after cart update.\n    ===================================================== */\n\n    async function forceOpenNativeDrawer() {\n\n\n      var deadline =\n        Date.now() +\n        2500;\n\n\n\n      while (\n        Date.now() <\n        deadline\n      ) {\n\n\n        var drawer =\n\n          document.getElementById(\n            'cart-drawer'\n          ) ||\n\n          document.querySelector(\n            'theme-drawer[id*=\"cart\"]'\n          );\n\n\n\n        if (drawer) {\n\n\n          /* wait until web component is upgraded */\n\n          try {\n\n\n            if (\n              window.customElements &&\n              customElements.whenDefined\n            ) {\n\n\n              await Promise.race([\n\n                customElements.whenDefined(\n                  'theme-drawer'\n                ),\n\n                delay(\n                  600\n                )\n\n              ]);\n\n\n            }\n\n\n          } catch (error) {}\n\n\n          /*\n            Query AGAIN because cart rendering may\n            have replaced the element.\n          */\n\n          drawer =\n\n            document.getElementById(\n              'cart-drawer'\n            ) ||\n\n            drawer;\n\n\n\n          /* -----------------------------------------\n             PRIMARY:\n             native Horizon ThemeDrawer.open()\n          ----------------------------------------- */\n\n          try {\n\n\n            if (\n              typeof drawer.open ===\n              'function'\n            ) {\n\n\n              drawer.open();\n\n\n              await nextPaint();\n\n\n              if (\n                drawer.hasAttribute(\n                  'open'\n                ) ||\n\n                drawer.querySelector(\n                  'dialog[open]'\n                )\n              ) {\n\n                return true;\n\n              }\n\n            }\n\n\n          } catch (error) {\n\n\n            console.warn(\n              'Bundle Builder: native drawer open failed',\n              error\n            );\n\n\n          }\n\n\n\n          /* -----------------------------------------\n             HARD FALLBACK:\n             open native dialog ourselves.\n             Still NO redirect to /cart.\n          ----------------------------------------- */\n\n          var dialog =\n            drawer.querySelector(\n              'dialog'\n            );\n\n\n          if (dialog) {\n\n\n            try {\n\n\n              drawer.setAttribute(\n                'open',\n                ''\n              );\n\n\n              if (\n                !dialog.open\n              ) {\n\n\n                if (\n                  window.matchMedia(\n                    '(max-width: 989px)'\n                  ).matches &&\n\n                  typeof dialog.showModal ===\n                    'function'\n                ) {\n\n\n                  dialog.showModal();\n\n\n                } else if (\n                  typeof dialog.show ===\n                    'function'\n                ) {\n\n\n                  dialog.show();\n\n\n                } else {\n\n\n                  dialog.setAttribute(\n                    'open',\n                    ''\n                  );\n\n\n                }\n\n              }\n\n\n              drawer.dispatchEvent(\n\n                new CustomEvent(\n                  'theme-drawer:open',\n                  {\n                    bubbles: true\n                  }\n                )\n\n              );\n\n\n              if (\n                dialog.open ||\n                dialog.hasAttribute(\n                  'open'\n                )\n              ) {\n\n                return true;\n\n              }\n\n\n            } catch (error) {\n\n\n              console.warn(\n                'Bundle Builder: dialog fallback failed',\n                error\n              );\n\n\n            }\n\n          }\n\n        }\n\n\n\n        await delay(\n          100\n        );\n\n      }\n\n\n      return false;\n\n    }\n\n\n\n    /* =====================================================\n       ADD BUNDLE\n    ===================================================== */\n\n    async function addBundle(\n      event\n    ) {\n\n\n      event.preventDefault();\n\n\n      event.stopImmediatePropagation();\n\n\n\n      if (adding) {\n        return;\n      }\n\n\n\n      if (\n        !isComplete()\n      ) {\n\n\n        setError(\n          'בחרי את כל 4 הצבעים לפני ההוספה לעגלה.'\n        );\n\n\n        return;\n\n      }\n\n\n\n      setError(\n        ''\n      );\n\n\n      showNativeLoading(\n        true\n      );\n\n\n      /*\n        Make Horizon's own cart drawer listener\n        auto-open when updateCart emits the add event.\n      */\n\n      primeNativeDrawerAutoOpen();\n\n\n\n      /* ===================================================\n         BUNDLE ID\n      =================================================== */\n\n      var bundleId =\n\n        'color-bundle-' +\n\n        Date.now()\n          .toString(36) +\n\n        '-' +\n\n        Math.random()\n          .toString(36)\n          .slice(2, 8);\n\n\n\n      /* ===================================================\n         GROUP ITEMS\n      =================================================== */\n\n      var grouped =\n        {};\n\n\n      selections.forEach(\n        function (item) {\n\n\n          if (\n            !grouped[\n              item.id\n            ]\n          ) {\n\n\n            grouped[\n              item.id\n            ] = {\n\n\n              gid:\n                item.gid,\n\n\n              quantity:\n                0\n\n\n            };\n\n\n          }\n\n\n          grouped[\n            item.id\n          ].quantity +=\n            1;\n\n\n        }\n      );\n\n\n\n      /* ===================================================\n         SHOPIFY STANDARD ACTION LINES\n      =================================================== */\n\n      var lines =\n\n        Object.keys(\n          grouped\n        )\n\n        .map(\n          function (key) {\n\n\n            return {\n\n\n              merchandiseId:\n                grouped[\n                  key\n                ].gid,\n\n\n              quantity:\n                grouped[\n                  key\n                ].quantity,\n\n\n              attributes: [\n\n                {\n                  key:\n                    '_bundle_id',\n\n                  value:\n                    bundleId\n                },\n\n                {\n                  key:\n                    '_bundle_type',\n\n                  value:\n                    'Color Bundle'\n                }\n\n              ]\n\n\n            };\n\n\n          }\n        );\n\n\n\n      try {\n\n\n        if (\n          !window.Shopify ||\n\n          !Shopify.actions ||\n\n          typeof Shopify.actions.updateCart !==\n            'function'\n        ) {\n\n\n          throw new Error(\n            'מערכת העגלה עדיין לא נטענה. רענני את העמוד ונסי שוב.'\n          );\n\n\n        }\n\n\n\n        /* =================================================\n           ADD ALL 4 VARIANTS\n        ================================================= */\n\n        var result =\n\n          await Shopify.actions.updateCart(\n\n            {\n              lines: lines\n            },\n\n            {\n              event: {\n\n                context:\n                  'product',\n\n                detail: {\n\n                  source:\n                    'color-bundle-builder'\n\n                }\n\n              }\n            }\n\n          );\n\n\n\n        /* =================================================\n           SHOPIFY CART ERRORS\n        ================================================= */\n\n        if (\n          result &&\n          result.userErrors &&\n          result.userErrors.length\n        ) {\n\n\n          throw new Error(\n\n            result\n              .userErrors[0]\n              .message ||\n\n            'לא הצלחנו להוסיף את הסט לעגלה.'\n\n          );\n\n        }\n\n\n\n        showNativeLoading(\n          false\n        );\n\n\n\n        /*\n          Allow Shopify/Horizon to finish rendering\n          the updated cart drawer.\n        */\n\n        await nextPaint();\n\n\n        await delay(\n          120\n        );\n\n\n\n        /* =================================================\n           OPEN DRAWER\n        ================================================= */\n\n        var opened =\n\n          await forceOpenNativeDrawer();\n\n\n\n        if (!opened) {\n\n\n          console.warn(\n            'Bundle Builder: cart was updated, but no native cart drawer could be opened.'\n          );\n\n\n        }\n\n\n\n        /* =================================================\n           READY FOR ANOTHER BUNDLE\n        ================================================= */\n\n        resetBuilder();\n\n\n\n      } catch (error) {\n\n\n        showNativeLoading(\n          false\n        );\n\n\n        setError(\n\n          error &&\n          error.message\n\n            ? error.message\n\n            : 'לא הצלחנו להוסיף את הסט לעגלה. נסי שוב.'\n\n        );\n\n\n      }\n\n    }\n\n\n\n    /* =====================================================\n       MAIN SLOT EVENTS\n    ===================================================== */\n\n    slots.forEach(\n      function (slot) {\n\n\n        slot.addEventListener(\n          'click',\n\n          function () {\n\n\n            openModal(\n\n              parseInt(\n\n                slot.getAttribute(\n                  'data-slot-index'\n                ),\n\n                10\n\n              )\n\n            );\n\n\n          }\n        );\n\n\n      }\n    );\n\n\n\n    /* =====================================================\n       MINI SLOT EVENTS\n    ===================================================== */\n\n    miniSlots.forEach(\n      function (mini) {\n\n\n        mini.addEventListener(\n          'click',\n\n          function () {\n\n\n            activeSlot =\n\n              parseInt(\n\n                mini.getAttribute(\n                  'data-mini-slot-index'\n                ),\n\n                10\n\n              );\n\n\n            refreshOptions();\n\n\n          }\n        );\n\n\n      }\n    );\n\n\n\n    /* =====================================================\n       SELECT COLOR\n    ===================================================== */\n\n    options.forEach(\n      function (button) {\n\n\n        button.addEventListener(\n          'click',\n\n          function () {\n\n\n            if (\n              button.disabled\n            ) {\n              return;\n            }\n\n\n\n            selections[\n              activeSlot\n            ] = {\n\n\n              id:\n                button.getAttribute(\n                  'data-variant-id'\n                ),\n\n\n              gid:\n                button.getAttribute(\n                  'data-variant-gid'\n                ),\n\n\n              title:\n                button.getAttribute(\n                  'data-title'\n                ) || '',\n\n\n              image:\n                button.getAttribute(\n                  'data-image'\n                ) || ''\n\n\n            };\n\n\n\n            setError(\n              ''\n            );\n\n\n            updateUI();\n\n\n\n            /*\n              Automatically move to the\n              next empty slot.\n            */\n\n            var nextEmpty =\n\n              selections.findIndex(\n                function (item) {\n\n                  return !item;\n\n                }\n              );\n\n\n\n            if (\n              nextEmpty !== -1\n            ) {\n\n\n              activeSlot =\n                nextEmpty;\n\n\n              refreshOptions();\n\n\n            } else {\n\n\n              /*\n                After choosing the 4th color\n                close the popup.\n              */\n\n              closeModal();\n\n\n            }\n\n\n          }\n        );\n\n\n      }\n    );\n\n\n\n    /* =====================================================\n       CLOSE POPUP\n    ===================================================== */\n\n    if (modalClose) {\n\n\n      modalClose.addEventListener(\n        'click',\n        closeModal\n      );\n\n\n    }\n\n\n    if (modalBack) {\n\n\n      modalBack.addEventListener(\n        'click',\n        closeModal\n      );\n\n\n    }\n\n\n    modal.addEventListener(\n      'click',\n\n      function (event) {\n\n\n        if (\n          event.target ===\n          modal\n        ) {\n\n\n          closeModal();\n\n\n        }\n\n\n      }\n    );\n\n\n    document.addEventListener(\n      'keydown',\n\n      function (event) {\n\n\n        if (\n          event.key ===\n            'Escape' &&\n\n          modal.classList.contains(\n            'is-open'\n          )\n        ) {\n\n\n          closeModal();\n\n\n        }\n\n\n      }\n    );\n\n\n\n    /* =====================================================\n       CONNECT ORIGINAL SHOPIFY ADD TO CART\n    ===================================================== */\n\n    var tries =\n      0;\n\n\n    function connectButton() {\n\n\n      tries +=\n        1;\n\n\n\n      if (\n        !findProductForm()\n      ) {\n\n\n        if (\n          tries < 40\n        ) {\n\n\n          window.setTimeout(\n            connectButton,\n            150\n          );\n\n\n        }\n\n\n        return;\n\n      }\n\n\n\n      var scope =\n\n        root.closest(\n          'product-info'\n        ) ||\n\n        root.closest(\n          '.shopify-section'\n        ) ||\n\n        document;\n\n\n\n      /*\n        Hide accelerated checkout so it\n        cannot bypass bundle selection.\n      */\n\n      var dynamicCheckout =\n\n        scope.querySelector(\n\n          '.shopify-payment-button, [data-shopify=\"payment-button\"]'\n\n        );\n\n\n      if (\n        dynamicCheckout\n      ) {\n\n\n        dynamicCheckout.style.display =\n          'none';\n\n\n      }\n\n\n\n      /*\n        Original Shopify button remains visible.\n        We intercept its form submit.\n      */\n\n      productForm.addEventListener(\n\n        'submit',\n\n        addBundle,\n\n        true\n\n      );\n\n\n\n      /*\n        Theme can try to alter disabled state.\n        Bundle state stays authoritative.\n      */\n\n      buttonObserver =\n\n        new MutationObserver(\n          function () {\n\n\n            if (\n              syncingButton\n            ) {\n              return;\n            }\n\n\n            window.setTimeout(\n              updateButton,\n              0\n            );\n\n\n          }\n        );\n\n\n      buttonObserver.observe(\n\n        addButton,\n\n        {\n\n          attributes:\n            true,\n\n          attributeFilter: [\n\n            'disabled',\n\n            'aria-disabled',\n\n            'aria-busy',\n\n            'class'\n\n          ]\n\n        }\n\n      );\n\n\n      updateButton();\n\n    }\n\n\n\n    /* =====================================================\n       START\n    ===================================================== */\n\n    updateUI();\n\n\n    connectButton();\n\n\n\n    /* =====================================================\n       BACK / BF CACHE FIX\n    ===================================================== */\n\n    window.addEventListener(\n\n      'pageshow',\n\n      function () {\n\n\n        adding =\n          false;\n\n\n        findProductForm();\n\n\n        updateUI();\n\n\n      }\n\n    );\n\n  }\n\n\n\n  /* =======================================================\n     INIT\n  ======================================================= */\n\n  if (\n    document.readyState ===\n    'loading'\n  ) {\n\n\n    document.addEventListener(\n\n      'DOMContentLoaded',\n\n      initBundleBuilder,\n\n      {\n        once: true\n      }\n\n    );\n\n\n  } else {\n\n\n    initBundleBuilder();\n\n\n  }\n\n})();\n\n</script>"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "custom_liquid_9BXwGB": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .guarantee-box {\n    direction: rtl;\n    width: 100%;\n    box-sizing: border-box;\n\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n\n    gap: 22px;\n\n    padding: 22px 26px;\n\n    background: #ffffff;\n\n    border: 1.5px solid #e2e2e2;\n    border-radius: 14px;\n\n    color: #171717;\n  }\n\n  /* =========================\n     GUARANTEE IMAGE\n  ========================== */\n\n  .guarantee-badge {\n    flex: 0 0 86px;\n    width: 86px;\n    height: 86px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .guarantee-badge img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: contain;\n\n    border: 0;\n  }\n\n\n  /* =========================\n     TEXT\n  ========================== */\n\n  .guarantee-content {\n    flex: 1;\n    min-width: 0;\n\n    text-align: right;\n  }\n\n  .guarantee-title {\n    margin: 0 0 8px 0;\n\n    font-size: 22px;\n    line-height: 1.25;\n\n    font-weight: 700;\n\n    color: #111111;\n  }\n\n  .guarantee-text {\n    margin: 0;\n\n    font-size: 18px;\n    line-height: 1.55;\n\n    font-weight: 400;\n\n    color: #292929;\n  }\n\n\n  /* =========================\n     MOBILE\n  ========================== */\n\n  @media screen and (max-width: 749px) {\n\n    .guarantee-box {\n      gap: 14px;\n\n      padding: 16px 16px;\n\n      border-radius: 12px;\n    }\n\n    .guarantee-badge {\n      flex-basis: 66px;\n\n      width: 66px;\n      height: 66px;\n    }\n\n    .guarantee-title {\n      margin-bottom: 5px;\n\n      font-size: 16px;\n      line-height: 1.3;\n    }\n\n    .guarantee-text {\n      font-size: 14px;\n      line-height: 1.45;\n    }\n  }\n\n\n  @media screen and (max-width: 370px) {\n\n    .guarantee-box {\n      gap: 11px;\n      padding: 14px 12px;\n    }\n\n    .guarantee-badge {\n      flex-basis: 60px;\n\n      width: 60px;\n      height: 60px;\n    }\n\n    .guarantee-title {\n      font-size: 15px;\n    }\n\n    .guarantee-text {\n      font-size: 13.5px;\n    }\n  }\n</style>\n\n\n<div class=\"guarantee-box\" dir=\"rtl\">\n\n  <!-- תמונת האחריות -->\n  <div class=\"guarantee-badge\">\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0825/1296/9956/files/ChatGPT_Image_Aug_17_2026_11_04_02_AM.webp?v=1786953896\"\n      alt=\"100 ימי אחריות להחזר כספי\"\n      loading=\"lazy\"\n      width=\"200\"\n      height=\"200\"\n    >\n\n  </div>\n\n\n  <!-- טקסט -->\n  <div class=\"guarantee-content\">\n\n    <div class=\"guarantee-title\">\n      100 ימי אחריות להחזר כספי\n    </div>\n\n    <p class=\"guarantee-text\">\n      לא התאהבת במדבקות הג׳ל שלנו? נחזיר לך 100% מהכסף.\n    </p>\n\n  </div>\n\n</div>"
          }
