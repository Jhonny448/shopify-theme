<div class=\"nail-story-modal-inner\">\n\n    <button\n      type=\"button\"\n      class=\"nail-story-modal-close\"\n      aria-label=\"סגירה\"\n    >\n      ×\n    </button>\n\n    <video\n      class=\"nail-story-modal-video\"\n      controls\n      playsinline\n    ></video>\n\n  </div>\n\n</div>\n\n\n<script>\n(function () {\n\n  const section = document.currentScript.closest('.shopify-section') || document;\n\n  const stories = section.querySelectorAll('.nail-story-circle');\n  const modal = section.querySelector('.nail-story-modal');\n\n  if (!modal || !stories.length) return;\n\n  const modalVideo = modal.querySelector('.nail-story-modal-video');\n  const closeButton = modal.querySelector('.nail-story-modal-close');\n\n  function openStory(story) {\n\n    const videoUrl = story.getAttribute('data-story-video');\n\n    if (!videoUrl) return;\n\n    modalVideo.src = videoUrl;\n\n    modal.classList.add('is-open');\n\n    document.body.style.overflow = 'hidden';\n\n    modalVideo.currentTime = 0;\n\n    modalVideo.play().catch(function () {});\n  }\n\n  function closeStory() {\n\n    modal.classList.remove('is-open');\n\n    modalVideo.pause();\n\n    modalVideo.removeAttribute('src');\n    modalVideo.load();\n\n    document.body.style.overflow = '';\n  }\n\n  stories.forEach(function (story) {\n\n    story.addEventListener('click', function () {\n      openStory(story);\n    });\n\n    story.addEventListener('keydown', function (event) {\n\n      if (event.key === 'Enter' || event.key === ' ') {\n        event.preventDefault();\n        openStory(story);\n      }\n\n    });\n\n  });\n\n  closeButton.addEventListener('click', closeStory);\n\n  modal.addEventListener('click', function (event) {\n\n    if (event.target === modal) {\n      closeStory();\n    }\n\n  });\n\n  document.addEventListener('keydown', function (event) {\n\n    if (\n      event.key === 'Escape' &&\n      modal.classList.contains('is-open')\n    ) {\n      closeStory();\n    }\n\n  });\n\n})();\n</script>"
