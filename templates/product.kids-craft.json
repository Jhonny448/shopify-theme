adow .18s ease,\n      transform .18s ease;\n    -webkit-tap-highlight-color: transparent;\n  }\n  #{{ bb_root_id }} .bb-slot:hover {\n    border-color: #9b9087;\n    box-shadow: 0 4px 13px rgba(0,0,0,.05);\n  }\n  #{{ bb_root_id }} .bb-slot:active {\n    transform: scale(.98);\n  }\n  #{{ bb_root_id }} .bb-slot-plus {\n    position: relative;\n    width: 18px;\n    height: 18px;\n    flex: 0 0 18px;\n  }\n  #{{ bb_root_id }} .bb-slot-plus::before,\n  #{{ bb_root_id }} .bb-slot-plus::after {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 16px;\n    height: 1.3px;\n    background: #211d19;\n    border-radius: 20px;\n    transform: translate(-50%, -50%);\n  }\n  #{{ bb_root_id }} .bb-slot-plus::after {\n    transform: translate(-50%, -50%) rotate(90deg);\n  }\n  #{{ bb_root_id }} .bb-slot-image {\n    display: none;\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n  }\n  #{{ bb_root_id }} .bb-slot.has-selection .bb-slot-image {\n    display: block;\n  }\n  #{{ bb_root_id }} .bb-slot.has-selection .bb-slot-plus {\n    display: none;\n  }\n  #{{ bb_root_id }} .bb-slot-name {\n    display: none;\n    position: absolute;\n    right: 4px;\n    bottom: 4px;\n    left: 4px;\n    padding: 4px 3px;\n    background: rgba(255,255,255,.94);\n    backdrop-filter: blur(5px);\n    -webkit-backdrop-filter: blur(5px);\n    border-radius: 5px;\n    font-size: 8px;\n    line-height: 1.2;\n    font-weight: 600;\n    text-align: center;\n    color: #191512;\n  }\n  #{{ bb_root_id }} .bb-slot.has-selection .bb-slot-name {\n    display: block;\n  }\n  #{{ bb_root_id }} .bb-slot-labels {\n    display: grid;\n    grid-template-columns: repeat({{ bb_slot_count }}, minmax(0,1fr));\n    gap: 7px;\n    margin-top: 6px;\n  }\n  #{{ bb_root_id }} .bb-slot-label {\n    font-size: 9px;\n    line-height: 1.3;\n    text-align: center;\n    color: #5a534d;\n  }\n  #{{ bb_root_id }}