            "custom_liquid": "<style>\n  .nail-story-section {\n    direction: rtl;\n    width: 100%;\n    padding: 20px 0;\n  }\n\n  .nail-story-wrapper {\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    gap: 34px;\n    width: 100%;\n    margin: 0 auto;\n  }\n\n  .nail-story-item {\n    width: 190px;\n    text-align: center;\n  }\n\n  .nail-story-circle {\n    position: relative;\n    width: 190px;\n    height: 190px;\n    border-radius: 50%;\n    padding: 6px;\n    background: #e1b78e;\n    overflow: hidden;\n    box-sizing: border-box;\n    cursor: pointer;\n    transition: transform 0.2s ease, opacity 0.2s ease;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .nail-story-circle:hover {\n    transform: scale(1.025);\n  }\n\n  .nail-story-circle:active {\n    transform: scale(0.98);\n  }\n\n  .nail-story-circle::after {\n    content: \"\";\n    position: absolute;\n    inset: 6px;\n    border: 5px solid #fff;\n    border-radius: 50%;\n    pointer-events: none;\n    z-index: 2;\n  }\n\n  .nail-story-video {\n    display: block;\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    object-fit: cover;\n    object-position: center;\n    background: #eee;\n    pointer-events: none;\n  }\n\n  .nail-story-title {\n    margin-top: 13px;\n    font-size: 23px;\n    line-height: 1.25;\n    font-weight: 400;\n    color: #181818;\n    white-space: nowrap;\n  }\n\n  /* MODAL */\n\n  .nail-story-modal {\n    position: fixed;\n    inset: 0;\n    z-index: 999999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 24px;\n    background: rgba(0, 0, 0, 0.82);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    opacity: 0;\n    visibility: hidden;\n    pointer-events: none;\n    transition: opacity 0.25s ease, visibility 0.25s ease;\n  }\n\n  .nail-story-modal.is-open {\n    opacity: 1;\n    visibility: visible;\n    pointer-events: auto;\n  }\n\n  .nail-story-modal-inner {\n    position: relative;\n    width: min(430px, 92vw);\n    max-height: 88vh;\n    transform: scale(0.94);\n    transition: transform 0.25s ease;\n  }\n\n  .nail-story-modal.is-open .nail-story-modal-inner {\n    transform: scale(1);\n  }\n\n  .nail-story-modal-video {\n    display: block;\n    width: 100%;\n    max-height: 85vh;\n    object-fit: contain;\n    border-radius: 18px;\n    background: #000;\n    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);\n  }\n\n  .nail-story-modal-close {\n    position: absolute;\n    top: -14px;\n    left: -14px;\n    z-index: 10;\n    width: 38px;\n    height: 38px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 0;\n    border-radius: 50%;\n    background: #fff;\n    color: #111;\n    font-size: 24px;\n    line-height: 1;\n    cursor: pointer;\n    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);\n  }\n\n  /* MOBILE */\n\n  @media screen and (max-width: 749px) {\n\n    .nail-story-section {\n      padding: 10px 0;\n    }\n\n    .nail-story-wrapper {\n      gap: 14px;\n      padding: 0 18px;\n      box-sizing: border-box;\n    }\n\n    .nail-story-item {\n      width: 142px;\n      max-width: calc(50% - 7px);\n    }\n\n    .nail-story-circle {\n      width: 142px;\n      max-width: 100%;\n      height: auto;\n      aspect-ratio: 1 / 1;\n      padding: 5px;\n    }\n\n    .nail-story-circle::after {\n      inset: 5px;\n      border-width: 4px;\n    }\n\n    .nail-story-title {\n      margin-top: 9px;\n      font-size: 16px;\n      line-height: 1.3;\n      white-space: nowrap;\n    }\n\n    .nail-story-modal {\n      padding: 18px;\n    }\n\n    .nail-story-modal-inner {\n      width: min(390px, 90vw);\n    }\n\n    .nail-story-modal-video {\n      max-height: 82vh;\n      border-radius: 16px;\n    }\n\n    .nail-story-modal-close {\n      top: -12px;\n      left: -10px;\n      width: 36px;\n      height: 36px;\n      font-size: 22px;\n    }\n  }\n\n  @media screen and (max-width: 370px) {\n\n    .nail-story-wrapper {\n      gap: 10px;\n      padding: 0 12px;\n    }\n\n    .nail-story-item {\n      width: 132px;\n    }\n\n    .nail-story-circle {\n      width: 132px;\n    }\n\n    .nail-story-title {\n      font-size: 15px;\n    }\n  }\n</style>\n\n\n<div class=\"nail-story-section\" dir=\"rtl\">\n\n  <div class=\"nail-story-wrapper\">\n\n    <!-- הדבקה -->\n    <div class=\"nail-story-item\">\n\n      <div\n        class=\"nail-story-circle\"\n        role=\"button\"\n        tabindex=\"0\"\n        data-story-video=\"https://cdn.shopify.com/videos/c/o/v/19f47a77b8be4f6fac15f114b8519440.mp4\"\n        aria-label=\"צפייה בסרטון הדבקה\"\n      >\n\n        <video\n          class=\"nail-story-video\"\n          autoplay\n          muted\n          loop\n          playsinline\n          preload=\"metadata\"\n        >\n          <source\n            src=\"https://cdn.shopify.com/videos/c/o/v/19f47a77b8be4f6fac15f114b8519440.mp4\"\n            type=\"video/mp4\"\n          >\n        </video>\n\n      </div>\n\n      <div class=\"nail-story-title\">\n        הדבקה תוך 9 דקות\n      </div>\n\n    </div>\n\n\n    <!-- הסרה -->\n    <div class=\"nail-story-item\">\n\n      <div\n        class=\"nail-story-circle\"\n        role=\"button\"\n        tabindex=\"0\"\n        data-story-video=\"https://cdn.shopify.com/videos/c/o/v/6932353d39914dcb981aa845e506f85b.mp4\"\n        aria-label=\"צפייה בסרטון הסרה\"\n      >\n\n        <video\n          class=\"nail-story-video\"\n          autoplay\n          muted\n          loop\n          playsinline\n          preload=\"metadata\"\n        >\n          <source\n            src=\"https://cdn.shopify.com/videos/c/o/v/6932353d39914dcb981aa845e506f85b.mp4\"\n            type=\"video/mp4\"\n          >\n        </video>\n\n      </div>\n\n      <div class=\"nail-story-title\">\n        הסרה תוך 5 דקות\n      </div>\n\n    </div>\n\n  </div>\n\n</div>\n\n\n<!-- חלון הסרטון -->\n<div class=\"nail-story-modal\">\n\n  <div class=\"nail-story-modal-inner\">\n\n    <button\n      type=\"button\"\n      class=\"nail-story-modal-close\"\n      aria-label=\"סגירה\"\n    >\n      ×\n    </button>\n\n    <video\n      class=\"nail-story-modal-video\"\n      controls\n      playsinline\n    ></video>\n\n  </div>\n\n</div>\n\n\n<script>\n(function () {\n\n  const section = document.currentScript.closest('.shopify-section') || document;\n\n  const stories = section.querySelectorAll('.nail-story-circle');\n  const modal = section.querySelector('.nail-story-modal');\n\n  if (!modal || !stories.length) return;\n\n  const modalVideo = modal.querySelector('.nail-story-modal-video');\n  const closeButton = modal.querySelector('.nail-story-modal-close');\n\n  function openStory(story) {\n\n    const videoUrl = story.getAttribute('data-story-video');\n\n    if (!videoUrl) return;\n\n    modalVideo.src = videoUrl;\n\n    modal.classList.add('is-open');\n\n    document.body.style.overflow = 'hidden';\n\n    modalVideo.currentTime = 0;\n\n    modalVideo.play().catch(function () {});\n  }\n\n  function closeStory() {\n\n    modal.classList.remove('is-open');\n\n    modalVideo.pause();\n\n    modalVideo.removeAttribute('src');\n    modalVideo.load();\n\n    document.body.style.overflow = '';\n  }\n\n  stories.forEach(function (story) {\n\n    story.addEventListener('click', function () {\n      openStory(story);\n    });\n\n    story.addEventListener('keydown', function (event) {\n\n      if (event.key === 'Enter' || event.key === ' ') {\n        event.preventDefault();\n        openStory(story);\n      }\n\n    });\n\n  });\n\n  closeButton.addEventListener('click', closeStory);\n\n  modal.addEventListener('click', function (event) {\n\n    if (event.target === modal) {\n      closeStory();\n    }\n\n  });\n\n  document.addEventListener('keydown', function (event) {\n\n    if (\n      event.key === 'Escape' &&\n      modal.classList.contains('is-open')\n    ) {\n      closeStory();\n    }\n\n  });\n\n})();\n</script>"
