    "custom_liquid_Tc3EW7": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .damage-free-section {\n    direction: rtl;\n    width: 100%;\n    box-sizing: border-box;\n\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n\n    background: #ffffff;\n\n    border: 1px solid #e8d1b6;\n    border-radius: 14px;\n\n    overflow: hidden;\n  }\n\n\n  /* =========================\n     IMAGE\n  ========================== */\n\n  .damage-free-image {\n    width: 100%;\n    height: 100%;\n    min-height: 520px;\n  }\n\n  .damage-free-image img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    object-position: center;\n\n    border: 0;\n  }\n\n\n  /* =========================\n     CONTENT\n  ========================== */\n\n  .damage-free-content {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n\n    padding: 54px 58px;\n\n    text-align: right;\n  }\n\n  .damage-free-title {\n    margin: 0 0 22px;\n\n    font-size: 38px;\n    line-height: 1.15;\n\n    font-weight: 750;\n\n    color: #201b17;\n  }\n\n  .damage-free-intro {\n    margin: 0 0 34px;\n\n    font-size: 19px;\n    line-height: 1.65;\n\n    font-weight: 400;\n\n    color: #49423d;\n  }\n\n\n  /* =========================\n     BENEFITS\n  ========================== */\n\n  .damage-free-benefits {\n    display: flex;\n    flex-direction: column;\n    gap: 25px;\n  }\n\n  .damage-free-benefit {\n    display: flex;\n    flex-direction: row;\n    align-items: flex-start;\n\n    gap: 15px;\n  }\n\n  .damage-free-icon {\n    flex: 0 0 28px;\n\n    width: 28px;\n    height: 28px;\n\n    margin-top: 1px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .damage-free-icon svg {\n    width: 24px;\n    height: 24px;\n\n    display: block;\n  }\n\n  .damage-free-benefit-content {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .damage-free-benefit-title {\n    margin: 0 0 5px;\n\n    font-size: 17px;\n    line-height: 1.4;\n\n    font-weight: 700;\n\n    color: #201b17;\n  }\n\n  .damage-free-benefit-text {\n    margin: 0;\n\n    font-size: 16px;\n    line-height: 1.6;\n\n    font-weight: 400;\n\n    color: #625b55;\n  }\n\n\n  /* =========================\n     MOBILE\n  ========================== */\n\n  @media screen and (max-width: 749px) {\n\n    .damage-free-section {\n      display: flex;\n      flex-direction: column;\n\n      border-radius: 12px;\n    }\n\n    /* התמונה תמיד ראשונה במובייל */\n    .damage-free-image {\n  order: 1;\n\n  width: calc(100% - 20px);\n  margin: 5px 10px 0;\n\n  min-height: unset;\n  height: auto;\n\n  aspect-ratio: 1 / 1;\n\n  border-radius: 10px;\n  overflow: hidden;\n}\n\n.damage-free-image img {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n  object-position: center;\n\n  border-radius: 10px;\n}\n\n    .damage-free-content {\n      order: 2;\n\n      padding: 28px 20px 30px;\n    }\n\n    .damage-free-title {\n      margin-bottom: 15px;\n\n      font-size: 27px;\n      line-height: 1.18;\n    }\n\n    .damage-free-intro {\n      margin-bottom: 25px;\n\n      font-size: 15px;\n      line-height: 1.6;\n    }\n\n    .damage-free-benefits {\n      gap: 21px;\n    }\n\n    .damage-free-benefit {\n      gap: 11px;\n    }\n\n    .damage-free-icon {\n      flex-basis: 22px;\n\n      width: 22px;\n      height: 22px;\n    }\n\n    .damage-free-icon svg {\n      width: 20px;\n      height: 20px;\n    }\n\n    .damage-free-benefit-title {\n      margin-bottom: 3px;\n\n      font-size: 15px;\n      line-height: 1.4;\n    }\n\n    .damage-free-benefit-text {\n      font-size: 14px;\n      line-height: 1.55;\n    }\n  }\n</style>\n\n\n<div class=\"damage-free-section\" dir=\"rtl\">\n\n\n  <!-- ========================\n       IMAGE\n       החלף כאן את ה-URL\n  ========================= -->\n\n  <div class=\"damage-free-image\">\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0825/1296/9956/files/hf_20260817_114910_ef5bb506-f850-4cf4-ba19-cd6de5e8c7e4.webp?v=1786967523\"\n      alt=\"מדבקות ג׳ל לציפורניים\"\n      loading=\"lazy\"\n    >\n\n  </div>\n\n\n  <!-- ========================\n       CONTENT\n  ========================= -->\n\n  <div class=\"damage-free-content\">\n\n\n    <h2 class=\"damage-free-title\">\n      המראה שאת רוצה.<br>\n      בלי הנזק.\n    </h2>\n\n\n    <p class=\"damage-free-intro\">\n      ציפורניים יפות לא צריכות לבוא על חשבון הציפורניים הטבעיות שלך.\n      מדבקות הג׳ל שלנו מעניקות לך מראה של מניקור מקצועי,\n      בזמן שהציפורניים הטבעיות יכולות להתאושש ולהתחזק.\n    </p>\n\n\n    <div class=\"damage-free-benefits\">\n\n\n      <!-- BENEFIT 1 -->\n      <div class=\"damage-free-benefit\">\n\n        <div class=\"damage-free-icon\" aria-hidden=\"true\">\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <circle\n              cx=\"12\"\n              cy=\"12\"\n              r=\"4\"\n              stroke=\"#D8A66F\"\n              stroke-width=\"1.5\"\n            />\n\n            <path\n              d=\"M12 2V5 M12 19V22 M2 12H5 M19 12H22 M4.9 4.9L7 7 M17 17L19.1 19.1 M19.1 4.9L17 7 M7 17L4.9 19.1\"\n              stroke=\"#D8A66F\"\n              stroke-width=\"1.5\"\n              stroke-linecap=\"round\"\n            />\n          </svg>\n\n        </div>\n\n\n        <div class=\"damage-free-benefit-content\">\n\n          <div class=\"damage-free-benefit-title\">\n            מאפשרות לציפורניים הטבעיות להתאושש\n          </div>\n\n          <p class=\"damage-free-benefit-text\">\n            בלי לפגוע בציפורן בזמן ההדבקה או ההסרה.\n            הציפורן שלך נשארת מוגנת בזמן שהיא מתאוששת ומתחזקת.\n          </p>\n\n        </div>\n\n      </div>\n\n\n      <!-- BENEFIT 2 -->\n      <div class=\"damage-free-benefit\">\n\n        <div class=\"damage-free-icon\" aria-hidden=\"true\">\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            xm