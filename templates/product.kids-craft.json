        "custom_liquid": "<style>\n  .damage-free-section {\n    direction: rtl;\n    width: 100%;\n    box-sizing: border-box;\n\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n\n    background: #ffffff;\n\n    border: 1px solid #e8d1b6;\n    border-radius: 14px;\n\n    overflow: hidden;\n  }\n\n\n  /* =========================\n     IMAGE\n  ========================== */\n\n  .damage-free-image {\n    width: 100%;\n    height: 100%;\n    min-height: 520px;\n  }\n\n  .damage-free-image img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    object-position: center;\n\n    border: 0;\n  }\n\n\n  /* =========================\n     CONTENT\n  ========================== */\n\n  .damage-free-content {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n\n    padding: 54px 58px;\n\n    text-align: right;\n  }\n\n  .damage-free-title {\n    margin: 0 0 22px;\n\n    font-size: 38px;\n    line-height: 1.15;\n\n    font-weight: 750;\n\n    color: #201b17;\n  }\n\n  .damage-free-intro {\n    margin: 0 0 34px;\n\n    font-size: 19px;\n    line-height: 1.65;\n\n    font-weight: 400;\n\n    color: #49423d;\n  }\n\n\n  /* =========================\n     BENEFITS\n  ========================== */\n\n  .damage-free-benefits {\n    display: flex;\n    flex-direction: column;\n    gap: 25px;\n  }\n\n  .damage-free-benefit {\n    display: flex;\n    flex-direction: row;\n    align-items: flex-start;\n\n    gap: 15px;\n  }\n\n  .damage-free-icon {\n    flex: 0 0 28px;\n\n    width: 28px;\n    height: 28px;\n\n    margin-top: 1px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .damage-free-icon svg {\n    width: 24px;\n    height: 24px;\n\n    display: block;\n  }\n\n  .damage-free-benefit-content {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .damage-free-benefit-title {\n    margin: 0 0 5px;\n\n    font-size: 17px;\n    line-height: 1.4;\n\n    font-weight: 700;\n\n    