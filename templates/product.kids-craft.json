er-radius: 50%;\n    object-fit: cover;\n    object-position: center;\n    background: #eee;\n    pointer-events: none;\n  }\n  #{{ ns_root_id }} .ns-title {\n    margin-top: 13px;\n    font-size: 23px;\n    line-height: 1.25;\n    font-weight: 400;\n    color: #181818;\n    white-space: nowrap;\n  }\n\n  /* =========================================================\n     MODAL\n     Lives on <body> (moved there by JS) so an ancestor with a\n     CSS transform cannot break position:fixed. Scoped to its\n     own id for that reason — do not nest it under the root id.\n  ========================================================= */\n  #{{ ns_modal_id }} {\n    position: fixed !important;\n    inset: 0 !important;\n    z-index: 2147483000 !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    padding: 12px !important;\n    margin: 0 !important;\n    direction: rtl;\n    background: rgba(0, 0, 0, .86);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    opacity: 0;\n    visibility: hidden;\n    pointer-events: none;\n    overscroll-behavior: contain;\n    transition: opacity .25s ease, visibility .25s ease;\n  }\n  #{{ ns_modal_id }}.is-open {\n    opacity: 1;\n    visibility: visible;\n    pointer-events: auto;\n  }\n  #{{ ns_modal_id }} * {\n    box-sizing: border-box;\n  }\n\n  /* 9:16 frame, sized off the viewport height so it fills most\n     of the screen without ever overflowing it */\n  #{{ ns_modal_id }} .ns-modal-frame {\n    position: relative;\n    width: min(440px, calc(100vw - 24px), calc(88vh * 0.5625));\n    width: min(440px, calc(100vw - 24px), calc(88dvh * 0.5625));\n    aspect-ratio: 9 / 16;\n    border-radius: 18px;\n    overflow: hidden;\n    background: #000;\n    box-shadow: 0 24px 70px rgba(0, 0, 0, .5);\n    transform: scale(.95);\n    transition: transform .25s ease;\n  }\n  #{{ ns_modal_id }}.is-open .ns-modal-frame {\n    transform: scale(1);\n  }\n  #{{ ns_modal_id }} .ns-modal-video {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    background: #000;\n  }\n\n  /* close button pinned to the overlay corner — always reachable */\n  #{{ ns_modal_id }} .ns-modal-close {\n    position: absolute;\n    top: max(14px, env(safe-area-inset-top));\n    left: 14px;\n    z-index: 10;\n    width: 42px;\n    height: 42px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0;\n    background: rgba(255, 255, 255, .95);\n    border: 0;\n    border-radius: 50%;\n    box-shadow: 0 4px 16px rgba(0, 0, 0, .3);\n    font-family: Arial, sans-serif;\n    font-size: 25px;\n    font-weight: 300;\n    line-height: 1;\n    color: #111;\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n  }\n  #{{ ns_modal_id }} .ns-modal-close:hover {\n    background: #ffffff;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #{{ ns_modal_id }},\n    #{{ ns_modal_id }} .ns-modal-frame {\n      transition: none;\n    }\n  }\n\n  /* =========================================================\n     MOBILE\n  ========================================================= */\n  @media screen and (max-width: 749px) {\n    #{{ ns_root_id }} {\n      padding: 10px 0;\n    }\n    #{{ ns_root_id }} .ns-wrapper {\n      gap: 14px;\n      padding: 0 18px;\n    }\n    #{{ ns_root_id }} .ns-item {\n      width: 142px;\n      max-width: calc(50% - 7px);\n    }\n    #{{ ns_root_id }} .ns-circle {\n      padding: 5px;\n    }\n    #{{ ns_root_id }} .ns-circle::after {\n      inset: 5px;\n      border-width: 4px;\n    }\n    #{{ ns_root_id }} .ns-title {\n      margin-top: 9px;\n      font-size: 16px;\n      line-height: 1.3;\n    }\n    #{{ ns_modal_id }} {\n      padding: 10px !important;\n    }\n    #{{ ns_modal_id }} .ns-modal-frame {\n      width: min(calc(100vw - 20px), calc(90vh * 0.5625));\n      width: min(calc(100vw - 20px), calc(90dvh * 0.5625));\n      border-radius: 15px;\n    }\n    #{{ ns_modal_id }} .ns-modal-close {\n      top: max(12px, env(safe-area-inset-top));\n      left: 12px;\n      width: 40px;\n      height: 40px;\n      font-size: 24px;\n    }\n  }\n  @media screen and (max-width: 370px) {\n    #{{ ns_root_id }} .ns-wrapper {\n      gap: 10px;\n      padding: 0 12px;\n    }\n    #{{ ns_root_id }} .ns-item {\n      width: 132px;\n      max-width: calc(50% - 5px);\n    }\n    #{{ ns_root_id }} .ns-title {\n      font-size: 15px;\n    }\n  }\n</style>\n\n<div id=\"{{ ns_root_id }}\" dir=\"rtl\">\n  <div class=\"ns-wrapper\">\n\n    <div class=\"ns-item\">\n      <button\n        type=\"button\"\n        class=\"ns-circle\"\n        data-story-video=\"{{ ns_video_1 }}\"\n        aria-label=\"צפייה בסרטון {{ ns_title_1 }}\"\n      >\n        <video class=\"ns-video\" autoplay muted loop playsinline preload=\"metadata\">\n          <source src=\"{{ ns_video_1 }}\" type=\"video/mp4\">\n        </video>\n      </button>\n      <div class=\"ns-title\">{{ ns_title_1 }}</div>\n    </div>\n\n    <div class=\"ns-item\">\n      <button\n        type=\"button\"\n        class=\"ns-circle\"\n        data-story-video=\"{{ ns_video_2 }}\"\n        aria-label=\"צפייה בסרטון {{ ns_title_2 }}\"\n      >\n        <video class=\"ns-video\" autoplay muted loop playsinline preload=\"metadata\">\n          <source src=\"{{ ns_video_2 }}\" type=\"video/mp4\">\n        </video>\n      </button>\n      <div class=\"ns-title\">{{ ns_title_2 }}</div>\n    </div>\n\n  </div>\n\n  <!-- moved to <body> on init -->\n  <div class=\"ns-modal\" id=\"{{ ns_modal_id }}\" aria-hidden=\"true\">\n    <button type=\"button\" class=\"ns-modal-close\" aria-label=\"סגירה\">&times;</button>\n    <div class=\"ns-modal-frame\" role=\"dialog\" aria-modal=\"true\" aria-label=\"סרטון\">\n      <video class=\"ns-modal-video\" controls playsinline preload=\"none\"></video>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var ROOT_ID  = '{{ ns_root_id }}';\n  var MODAL_ID = '{{ ns_modal_id }}';\n\n  function initStories() {\n    var root = document.getElementById(ROOT_ID);\n    if (!root || root.dataset.nsInit === '1') { return; }\n    root.dataset.nsInit = '1';\n\n    var modal = root.querySelector('.ns-modal');\n    if (!modal) { return; }\n\n    /* ---------------------------------------------------\n       Move the modal to <body>.\n       The product info wrapper on this theme animates with\n       `transform`, and a transformed ancestor makes\n       position:fixed resolve against IT instead of the\n       viewport — that is why the video was stuck inside the\n       section, cropped, and unscrollable.\n    --------------------------------------------------- */\n    var orphan = document.getElementById(MODAL_ID);\n    if (orphan && orphan !== modal && orphan.parentNode) {\n      orphan.parentNode.removeChild(orphan);\n    }\n    document.body.appendChild(modal);\n\n    var circles     = Array.prototype.slice.call(root.querySelectorAll('.ns-circle'));\n    var previews    = Array.prototype.slice.call(root.querySelectorAll('.ns-video'));\n    var modalVideo  = modal.querySelector('.ns-modal-video');\n    var closeButton = modal.querySelector('.ns-modal-close');\n    var scrollY     = 0;\n    var isOpen      = false;\n\n    if (!circles.length || !modalVideo) { return; }\n\n    /* Lock the page without losing the scroll position.\n       `overflow:hidden` alone lets iOS Safari keep scrolling\n       the body behind the overlay. */\n    function lockScroll() {\n      scrollY = window.scrollY || window.pageYOffset || 0;\n      document.body.style.position = 'fixed';\n      document.body.style.top = '-' + scrollY + 'px';\n      document.body.style.left = '0';\n      document.body.style.right = '0';\n      document.body.style.width = '100%';\n      document.body.style.overflow = 'hidden';\n    }\n\n    function unlockScroll() {\n      document.body.style.position = '';\n      document.body.style.top = '';\n      document.body.style.left = '';\n      document.body.style.right = '';\n      document.body.style.width = '';\n      document.body.style.overflow = '';\n      window.scrollTo(0, scrollY);\n    }\n\n    function openStory(circle) {\n      var url = circle.getAttribute('data-story-video');\n      if (!url || isOpen) { return; }\n      isOpen = true;\n\n      /* pause the looping thumbnails while the big one plays */\n      previews.forEach(function (v) { try { v.pause(); } catch (e) {} });\n\n      modalVideo.src = url;\n      modalVideo.currentTime = 0;\n      modalVideo.muted = false;\n\n      lockScroll();\n      modal.classList.add('is-open');\n      modal.setAttribute('aria-hidden', 'false');\n\n      var attempt = modalVideo.play();\n      if (attempt && typeof attempt.catch === 'function') {\n        attempt.catch(function () {\n          /* browser blocked sound — play muted rather than not at all */\n          modalVideo.muted = true;\n          var retry = modalVideo.play();\n          if (retry && typeof retry.catch === 'function') { retry.catch(function () {}); }\n        });\n      }\n\n      window.setTimeout(function () {\n        try { closeButton.focus({ preventScroll: true }); } catch (e) {}\n      }, 80);\n    }\n\n    function closeStory() {\n      if (!isOpen) { return; }\n      isOpen = false;\n\n      modal.classList.remove('is-open');\n      modal.setAttribute('aria-hidden', 'true');\n\n      try { modalVideo.pause(); } catch (e) {}\n      modalVideo.removeAttribute('src');\n      modalVideo.load();\n\n      unlockScroll();\n      previews.forEach(function (v) { try { v.play(); } catch (e) {} });\n    }\n\n    circles.forEach(function (circle) {\n      circle.addEventListener('click', function () { openStory(circle); });\n    });\n\n    closeButton.addEventListener('click', closeStory);\n\n    /* tap the dark area to close, but never the video itself */\n    modal.addEventListener('click', function (event) {\n      if (event.target === modal) { closeStory(); }\n    });\n\n    document.addEventListener('keydown', function (event) {\n      if (event.key === 'Escape' && isOpen) { closeStory(); }\n    });\n\n    /* back button closes the video instead of leaving the page */\n    window.addEventListener('popstate', function () {\n      if (isOpen) { closeStory(); }\n    });\n\n    /* theme editor: drop the portaled modal when the section reloads */\n    document.addEventListener('shopify:section:unload', function (event) {\n      if (event.target && event.target.contains && event.target.contains(root)) {\n        if (isOpen) { closeStory(); }\n        if (modal.parentNode) { modal.parentNode.removeChild(modal); }\n      }\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initStories, { once: true });\n  } else {\n    initStories();\n  }\n})();\n</script>"
