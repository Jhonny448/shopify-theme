    "custom_liquid_dD4fxW": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  ==================================================================\n  GEL FILM v2 — scroll-scrubbed application film\n  Shopify \"Custom Liquid\" section.\n\n  TWO SEPARATE FILMS, ONE BLOCK:\n    · MOBILE  9:16  — 432x768  · gfm_01.webp … gfm_50.webp  (50 sheets, 3.5MB)\n    · DESKTOP 16:9  — 1024x576 · gfd_01.webp … gfd_50.webp  (50 sheets, 5.1MB)\n\n  The browser loads ONE set only. A phone never downloads a\n  desktop byte, and the reverse. The switch happens before the\n  first request, not with CSS.\n\n  449 frames @30fps · no copy · no libraries · ~6KB JS\n  ==================================================================\n{%- endcomment -%}\n\n{%- assign GF_FRAMES   = 449 -%}\n{%- assign M_SHEETS    = 50  -%}\n{%- assign D_SHEETS    = 50  -%}\n{%- assign GF_BREAK    = 900 -%}\n\n{%- comment -%} ---------- MOBILE 9:16 ---------- {%- endcomment -%}\n{%- assign M_W = 432 -%}{%- assign M_H = 768 -%}\n{%- assign M_COLS = 3 -%}{%- assign M_ROWS = 3 -%}\n\n{%- comment -%} ---------- DESKTOP 16:9 --------- {%- endcomment -%}\n{%- assign D_W = 1024 -%}{%- assign D_H = 576 -%}\n{%- assign D_COLS = 3 -%}{%- assign D_ROWS = 3 -%}\n\n<div class=\"gf2\" id=\"gf2\">\n  <div class=\"gf2-stick\">\n    <div class=\"gf2-stage\">\n      <canvas id=\"gf2-c\" role=\"img\"\n              aria-label=\"Applying a pre-cured gel nail wrap: placing, pressing, trimming and filing.\"></canvas>\n    </div>\n    <div class=\"gf2-bar\" id=\"gf2-bar\"><i></i></div>\n  </div>\n</div>\n\n<style>\n  #gf2{\n    --gf-bg:#422925;\n    position:relative;\n    width:100vw;\n    margin-left:calc(50% - 50vw);\n    background:var(--gf-bg);\n    height:420svh;                 /* scroll distance — see README */\n  }\n  #gf2 .gf2-stick{\n    position:sticky; top:0;\n    height:100svh;\n    display:flex; align-items:center; justify-content:center;\n    overflow:hidden;\n  }\n  #gf2 .gf2-stage{ position:relative; line-height:0; }\n  #gf2 canvas{\n    display:block;\n    opacity:0; transition:opacity .5s ease;\n    width:100%; height:100%;\n  }\n  #gf2.is-ready canvas{ opacity:1; }\n\n  /* MOBILE 9:16 — fills the screen edge to edge */\n  #gf2.is-mobile .gf2-stage{\n    width:100vw;\n    height:100svh;\n  }\n  #gf2.is-mobile canvas{ object-fit:cover; }\n\n  /* DESKTOP 16:9 — full-bleed cinematic band */\n  #gf2.is-desktop .gf2-stage{\n    width:100vw;\n    height:min(100svh, 56.25vw);\n  }\n  #gf2.is-desktop canvas{ object-fit:cover; }\n\n  #gf2 .gf2-bar{\n    position:absolute; left:50%; bottom:5svh; transform:translateX(-50%);\n    width:92px; height:2px; background:rgba(255,255,255,.14);\n    transition:opacity .45s ease;\n  }\n  #gf2 .gf2-bar i{ display:block; height:100%; width:0;\n    background:rgba(255,255,255,.7); transition:width .2s linear; }\n  #gf2.is-ready .gf2-bar{ opacity:0; }\n\n  /* sticky killed by a theme ancestor, or reduced motion */\n  #gf2.no-stick, #gf2.is-still{ height:auto; }\n  #gf2.no-stick .gf2-stick, #gf2.is-still .gf2-stick{ position:relative; height:auto; }\n  #gf2.no-stick.is-mobile .gf2-stage, #gf2.is-still.is-mobile .gf2-stage{ height:auto; aspect-ratio:9/16; }\n  #gf2.no-stick.is-desktop .gf2-stage, #gf2.is-still.is-desktop .gf2-stage{ height:auto; aspect-ratio:16/9; }\n\n  @media (prefers-reduced-motion: reduce){\n    #gf2{ height:auto; }\n    #gf2 .gf2-stick{ position:relative; height:auto; }\n  }\n</style>\n\n<script>\n(function(){\n  var root = document.getElementById('gf2');\n  var cv   = document.getElementById('gf2-c');\n  var bar  = document.querySelector('#gf2-bar i');\n  if(!root || !cv) return;\n\n  /* ============ the two films, kept deliberately separate ============ */\n  var MOBILE = {\n    w: {{ M_W }}, h: {{ M_H }}, cols: {{ M_COLS }}, rows: {{ M_ROWS }},\n    urls: [\n      {%- for i in (1..M_SHEETS) -%}\n        {%- assign n = i | prepend: '0' | slice: -2, 2 -%}\n        {%- assign f = 'gfm_' | append: n | append: '.webp' -%}\n        \"{{ f | file_url }}\"{%- unless forloop.last -%},{%- endunless -%}\n      {%- endfor -%}\n    ]\n  };\n  var DESKTOP = {\n    w: {{ D_W }}, h: {{ D_H }}, cols: {{ D_COLS }}, rows: {{ D_ROWS }},\n    urls: [\n      {%- for i in (1..D_SHEETS) -%}\n        {%- assign n = i | prepend: '0' | slice: -2, 2 -%}\n        {%- assign f = 'gfd_' | append: n | append: '.webp' -%}\n        \"{{ f | file_url }}\"{%- unless forloop.last -%},{%- endunless -%}\n      {%- endfor -%}\n    ]\n  };\n  /* =================================================================== */\n\n  var TOTAL = {{ GF_FRAMES }};\n  var isMobile = innerWidth < {{ GF_BREAK }};\n  var F = isMobile ? MOBILE : DESKTOP;\n\n  F.urls = F.urls.filter(function(u){ return u && u.length > 4; });\n  if(!F.urls.length){ root.style.display='none'; return; }\n\n  root.classList.add(isMobile ? 'is-mobile' : 'is-desktop');\n\n  var PER = F.cols * F.rows;\n  cv.width = F.w; cv.height = F.h;          // DPR pinned at 1, canvas = source\n  var ctx = cv.getContext('2d', { alpha:false });\n\n  var sheets = new Array(F.urls.length);\n  var got = 0, ready = false, raf = 0;\n  var target = 0, current = 0, lastDrawn = -1;\n\n  var still = matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  function stickyBroken(el){\n    for(var p = el.parentElement; p && p !== document.documentElement; p = p.parentElement){\n      var cs = getComputedStyle(p);\n      if(cs.overflowX !== 'visible' || cs.overflowY !== 'visible') return true;\n      if(cs.transform !== 'none' || cs.perspective !== 'none' || cs.filter !== 'none') return true;\n      if(cs.contain && cs.contain.indexOf('paint') > -1) return true;\n    }\n    return false;\n  }\n  var pinned = !still && !stickyBroken(root);\n  if(!pinned) root.classList.add('no-stick');\n  if(still)   root.classList.add('is-still');\n\n  function pick(i){\n    var s = (i / PER) | 0;\n    if(sheets[s]) return { s:s, k:i % PER };\n    for(var d = 1; d < sheets.length; d++){\n      if(sheets[s-d]) return { s:s-d, k:PER-1 };\n      if(sheets[s+d]) return { s:s+d, k:0 };\n    }\n    return null;\n  }\n\n  function draw(i, force){\n    i = i < 0 ? 0 : (i > TOTAL-1 ? TOTAL-1 : i|0);\n    if(i === lastDrawn && !force) return;\n    var p = pick(i); if(!p) return;\n    lastDrawn = i;\n    ctx.drawImage(sheets[p.s],\n      (p.k % F.cols) * F.w, ((p.k / F.cols)|0) * F.h, F.w, F.h,\n      0, 0, F.w, F.h);\n  }\n\n  function progress(){\n    var r = root.getBoundingClientRect();\n    if(pinned){\n      var span = r.height - innerHeight;\n      if(span <= 0) return 0;\n      var v = -r.top / span;\n      return v < 0 ? 0 : (v > 1 ? 1 : v);\n    }\n    var v = (innerHeight - r.top) / (innerHeight + r.height);\n    return v < 0 ? 0 : (v > 1 ? 1 : v);\n  }\n\n  /* lerp 0.42 — locked to the finger, not trailing behind it */\n  function tick(){\n    raf = 0;\n    current += (target - current) * 0.42;\n    if(Math.abs(target - current) < 0.3) current = target;\n    draw(Math.round(current));\n    if(current !== target) go();\n  }\n  function go(){ if(!raf) raf = requestAnimationFrame(tick); }\n  function onScroll(){ target = progress() * (TOTAL - 1); go(); }\n\n  /* two-pass load: every other sheet first, so the whole film is\n     scrubbable at half the bytes; the rest fill in behind it */\n  function order(n){\n    var a = [], i;\n    for(i = 0; i < n; i += 2) a.push(i);\n    for(i = 1; i < n; i += 2) a.push(i);\n    return a;\n  }\n  var queue = order(F.urls.length), qi = 0;\n\n  function pump(){\n    if(qi >= queue.length) return;\n    var n = queue[qi++];\n    var img = new Image();\n    img.decoding = 'async';\n    img.onload = function(){\n      /* Decode BEFORE the sheet is ever drawn. Without this the first draw\n         from each sheet decodes a multi-megapixel WebP on the main thread,\n         which is the periodic stutter people describe as \"missing frames\". */\n      var use = function(){\n        sheets[n] = img; got++;\n      if(bar) bar.style.width = Math.round(got / F.urls.length * 100) + '%';\n        if(!ready){ ready = true; root.classList.add('is-ready'); onScroll(); draw(Math.round(current), true); }\n        pump();\n      };\n      if(img.decode) img.decode().then(use).catch(use); else use();\n    };\n    img.onerror = function(){ got++; pump(); };\n    img.src = F.urls[n];\n  }\n  pump(); pump();                      // two in flight\n\n  if(still){ return; }\n\n  addEventListener('scroll', onScroll, { passive:true });\n  addEventListener('resize', onScroll, { passive:true });\n  onScroll();\n})();\n</script>",
        "color_scheme": "",
