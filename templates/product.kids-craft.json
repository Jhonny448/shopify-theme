    "custom_liquid_wEpC78": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  LOREN — טבלת השוואה\n  לעריכת השורות: פשוט ערוך את הרשימה הבאה. כל שורה מופרדת ב־ |\n{%- endcomment -%}\n\n{%- assign lc_title_line_1 = 'בריא יותר לציפורניים. פשוט יותר.' -%}\n{%- assign lc_title_line_2 = 'נוח יותר. ומשתלם יותר.' -%}\n{%- assign lc_brand = 'LOREN' -%}\n{%- assign lc_rival = 'מניקוריסטית' -%}\n\n{%- assign lc_rows = 'מאפשר לציפורניים הטבעיות לצמוח ולהתחזק|בלי שיוף במכונה ובלי הסרת שכבות מהציפורן|בלי UV, אצטון או חומרים אגרסיביים|מניקור מושלם בבית תוך דקות|בלי לשלם שוב ושוב למניקוריסטית|100 ימי אחריות להחזר כספי' | split: '|' -%}\n\n<style>\n  .loren-compare {\n    direction: rtl;\n    width: 100%;\n    box-sizing: border-box;\n    padding: 26px 16px 32px;\n    color: #231d19;\n    font-family: inherit;\n  }\n  .loren-compare * {\n    box-sizing: border-box;\n  }\n  .loren-compare__inner {\n    width: 100%;\n    max-width: 1000px;\n    margin: 0 auto;\n  }\n\n  /* =========================\n     TITLE\n  ========================= */\n  .loren-compare__title {\n    margin: 0 0 22px;\n    font-size: clamp(21px, 3.4vw, 34px);\n    line-height: 1.2;\n    font-weight: 750;\n    letter-spacing: -0.02em;\n    text-align: right;\n    color: #1c1815;\n  }\n\n  /* =========================\n     TABLE  (one table at every width)\n  ========================= */\n  .loren-compare__table {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n  }\n  .loren-compare__table col.is-feature { width: 52%; }\n  .loren-compare__table col.is-brand   { width: 24%; }\n  .loren-compare__table col.is-rival   { width: 24%; }\n\n  .loren-compare__table th,\n  .loren-compare__table td {\n    padding: 15px 8px;\n    vertical-align: middle;\n    text-align: center;\n  }\n\n  /* header */\n  .loren-compare__table thead th {\n    padding-top: 16px;\n    padding-bottom: 16px;\n    font-size: clamp(12px, 1.4vw, 17px);\n    line-height: 1.25;\n    font-weight: 700;\n    color: #1c1815;\n    letter-spacing: 0.01em;\n  }\n  .loren-compare__head-feature {\n    text-align: right !important;\n    padding-right: 0 !important;\n  }\n\n  /* feature column */\n  .loren-compare__feature {\n    padding-right: 0 !important;\n    padding-left: 12px !important;\n    font-size: clamp(12.5px, 1.35vw, 17px);\n    line-height: 1.45;\n    font-weight: 400;\n    color: #4f4842;\n    text-align: right;\n    text-wrap: pretty;\n  }\n\n  /* the highlighted brand column — one continuous band,\n     no rules cutting through it */\n  .loren-compare__brand-head,\n  .loren-compare__brand {\n    background: #f4eee8;\n  }\n  .loren-compare__brand-head {\n    border-radius: 14px 14px 0 0;\n  }\n  .loren-compare__table tbody tr:last-child .loren-compare__brand {\n    border-radius: 0 0 14px 14px;\n  }\n\n  /* hairlines: everywhere EXCEPT the brand band */\n  .loren-compare__table tbody td.loren-compare__feature,\n  .loren-compare__table tbody td.loren-compare__rival {\n    border-top: 1px solid #e9e3dd;\n  }\n\n  /* =========================\n     ICONS\n  ========================= */\n  .loren-compare__icon {\n    width: clamp(22px, 2.4vw, 28px);\n    height: clamp(22px, 2.4vw, 28px);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 7px;\n    vertical-align: middle;\n  }\n  .loren-compare__icon svg {\n    width: 58%;\n    height: 58%;\n    display: block;\n  }\n  .loren-compare__icon--yes {\n    background: #1f1915;\n    color: #ffffff;\n  }\n  .loren-compare__icon--no {\n    background: #ffffff;\n    color: #211c18;\n    border: 1.5px solid #d8d1ca;\n  }\n\n  /* =========================\n     NARROW SCREENS\n  ========================= */\n  @media screen and (max-width: 749px) {\n    .loren-compare {\n      padding: 18px 14px 22px;\n    }\n    .loren-compare__title {\n      margin-bottom: 16px;\n    }\n    .loren-compare__table col.is-feature { width: 54%; }\n    .loren-compare__table col.is-brand   { width: 23%; }\n    .loren-compare__table col.is-rival   { width: 23%; }\n    .loren-compare__table th,\n    .loren-compare__table td {\n      padding: 13px 4px;\n    }\n    .loren-compare__table thead th {\n      padding-top: 13px;\n      padding-bottom: 13px;\n    }\n    .loren-compare__feature {\n      padding-left: 8px !important;\n    }\n    .loren-compare__brand-head { border-radius: 11px 11px 0 0; }\n    .loren-compare__table tbody tr:last-child .loren-compare__brand {\n      border-radius: 0 0 11px 11px;\n    }\n  }\n</style>\n\n<div class=\"loren-compare\" dir=\"rtl\">\n  <div class=\"loren-compare__inner\">\n\n    <h2 class=\"loren-compare__title\">\n      {{ lc_title_line_1 }}<br>\n      {{ lc_title_line_2 }}\n    </h2>\n\n    <table class=\"loren-compare__table\">\n      <colgroup>\n        <col class=\"is-feature\">\n        <col class=\"is-brand\">\n        <col class=\"is-rival\">\n      </colgroup>\n\n      <thead>\n        <tr>\n          <th class=\"loren-compare__head-feature\" scope=\"col\"><span class=\"visually-hidden\"></span></th>\n          <th class=\"loren-compare__brand-head\" scope=\"col\">{{ lc_brand }}</th>\n          <th scope=\"col\">{{ lc_rival }}</th>\n        </tr>\n      </thead>\n\n      <tbody>\n        {%- for row in lc_rows -%}\n          <tr>\n            <td class=\"loren-compare__feature\">{{ row | strip }}</td>\n            <td class=\"loren-compare__brand\">\n              <span class=\"loren-compare__icon loren-compare__icon--yes\" role=\"img\" aria-label=\"כן\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                  <path d=\"M5 12.5L9.5 17L19 7\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                </svg>\n              </span>\n            </td>\n            <td class=\"loren-compare__rival\">\n              <span class=\"loren-compare__icon loren-compare__icon--no\" role=\"img\" aria-label=\"לא\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                  <path d=\"M7 7L17 17M17 7L7 17\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n                </svg>\n              </span>\n            </td>\n          </tr>\n        {%- endfor -%}\n      </tbody>\n    </table>\n\n  </div>\n</div>",
